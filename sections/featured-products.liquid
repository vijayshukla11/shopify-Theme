{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Enterprise Featured Products Showcase
  File: sections/featured-products.liquid
  Sprint: 2.4 - Enterprise Product Card System
{%- endcomment -%}

{%- assign selected_collection = section.settings.collection -%}
{%- assign product_limit = section.settings.products_to_show | default: 8 -%}
{%- assign desktop_cols = section.settings.columns_desktop | default: 4 -%}
{%- assign mobile_cols = section.settings.columns_mobile | default: '2' -%}

<section
  class="ncf-featured-products-section"
  id="ncf-featured-products-{{ section.id }}"
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#0f172a' }};
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  "
  aria-label="{{ section.settings.accessibility_label | default: 'Featured Collection Products' }}"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    {%- comment -%} 1. SECTION HEADER {%- endcomment -%}
    {%- assign section_heading = section.settings.heading | default: section.settings.title -%}
    {%- if section_heading != blank or section.settings.eyebrow != blank -%}
      <div class="ncf-featured-products__header text-{{ section.settings.header_alignment | default: 'center' }} mb-10">
        {%- if section.settings.eyebrow != blank -%}
          <span class="inline-block text-xs font-mono font-extrabold uppercase tracking-widest text-sky-600 mb-2">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section_heading != blank -%}
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 uppercase">
            {{ section_heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="text-slate-600 text-sm sm:text-base max-w-2xl mt-2 {% if section.settings.header_alignment == 'center' %}mx-auto{% endif %}">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} 2. FEATURED PRODUCTS GRID {%- endcomment -%}
    <div
      class="grid gap-6 grid-cols-{{ mobile_cols }} sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-{{ desktop_cols }}"
    >
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products limit: product_limit -%}
          {% render 'product-card',
            product: product,
            card_style: section.settings.card_style,
            media_aspect_ratio: section.settings.media_aspect_ratio,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor,
            show_rating: section.settings.show_rating,
            show_badges: section.settings.show_badges,
            show_quick_view: section.settings.show_quick_view,
            show_wishlist: section.settings.show_wishlist,
            show_compare: section.settings.show_compare,
            show_add_to_cart: section.settings.show_add_to_cart,
            hover_animation: section.settings.hover_animation
          %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} FALLBACK PRESET CARDS WHEN NO COLLECTION SELECTED {%- endcomment -%}
        {%- for i in (1..product_limit) -%}
          <div class="ncf-product-card ncf-product-card--{{ section.settings.card_style | default: 'classic' }}">
            <div class="ncf-product-card__media-wrapper aspect-[3/4]">
              {{ 'product-1' | placeholder_svg_tag: 'ncf-product-card__placeholder' }}
            </div>
            <div class="ncf-product-card__details">
              <div class="ncf-product-card__vendor">CLINZA</div>
              <h3 class="ncf-product-card__title">
                <a href="#" class="ncf-product-card__title-link">CLINZA Flagship Electronics #{{ i }}</a>
              </h3>
              <div class="ncf-price font-mono font-bold text-sky-600">₹1,999.00</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} 3. VIEW ALL COLLECTION LINK BUTTON (OPTIONAL) {%- endcomment -%}
    {%- if section.settings.show_view_all and selected_collection != blank -%}
      <div class="text-center mt-12">
        <a
          href="{{ selected_collection.url }}"
          class="ncf-btn ncf-btn--primary"
        >
          <span>{{ section.settings.view_all_label | default: 'View All Products' }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Products Grid",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CURATED SELECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Hardware"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Description",
      "default": "Precision engineered audio equipment and flagship computing devices."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Center Aligned" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Collection & Layout"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Card Visual Options"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card Visual Style",
      "options": [
        { "value": "classic", "label": "Classic (Clean Border & Shadow)" },
        { "value": "minimal", "label": "Minimal (Flat Transparent)" },
        { "value": "bordered", "label": "Bordered (Thick Accent Border)" },
        { "value": "luxury", "label": "Luxury (Dark Premium Gloss)" },
        { "value": "compact", "label": "Compact (High Density Grid)" }
      ],
      "default": "classic"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Media Aspect Ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "adapt", "label": "Adapt to Image" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "hover_animation",
      "label": "Hover Animation Effect",
      "options": [
        { "value": "zoom", "label": "Image Scale Zoom" },
        { "value": "lift", "label": "Card Translate Lift" },
        { "value": "none", "label": "None" }
      ],
      "default": "zoom"
    },
    {
      "type": "header",
      "content": "Card Features & Toggles"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show Secondary Image on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor Title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Star Ratings",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show Badges (Sale/New/Sold Out)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Show Quick View Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Toggle Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show Compare Toggle Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Quick Add To Cart Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button below Grid",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View All' Button Label",
      "default": "View All Products"
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured Products Grid"
    }
  ]
}
{% endschema %}
