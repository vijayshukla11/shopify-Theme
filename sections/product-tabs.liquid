{%- comment -%}
  CLINZA Commerce - Snippet: Product Accordions & Details System
  File: snippets/product-tabs.liquid
  Architecture: Minimalist, accessible accordions for Product Details, Specifications,
  What's in the Box (dynamic only), Shipping & Returns, and Warranty.
{%- endcomment -%}

{%- assign box_contents = product.metafields.custom.box_contents.value | default: product.metafields.specs.box_contents.value -%}
{%- assign warranty_info = product.metafields.custom.warranty.value | default: product.metafields.specs.warranty.value -%}

<div class="ncf-pdp-accordions-container w-full my-8 max-w-4xl" data-pdp-accordions>
  <div class="divide-y divide-[#E5E7E5] border-y border-[#E5E7E5]">

    {%- comment -%} 1. PRODUCT DETAILS (Description) {%- endcomment -%}
    <div class="ncf-pdp-accordion-group py-2" data-accordion-item>
      <button
        type="button"
        class="w-full py-4 text-left flex items-center justify-between text-[#111827] hover:text-[#173D32] transition-colors focus:outline-none group"
        data-accordion-trigger
        aria-expanded="true"
        aria-controls="pdp-accordion-details"
      >
        <span class="text-sm font-bold uppercase tracking-wider font-mono">Product Details</span>
        <span class="w-6 h-6 rounded-full flex items-center justify-center text-[#111827] group-hover:text-[#173D32] transition-transform duration-200" data-accordion-icon aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-minus"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-plus hidden"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </span>
      </button>

      <div
        id="pdp-accordion-details"
        role="region"
        class="ncf-pdp-accordion-content pb-5 pt-1 text-xs sm:text-sm text-[#111827] leading-relaxed block"
      >
        <div class="prose max-w-none text-[#667085] space-y-3">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>High-performance electronic hardware precision-crafted for long-term daily reliability and seamless modern connectivity.</p>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} 2. SPECIFICATIONS (Only rendered when real product metafield specs exist) {%- endcomment -%}
    {%- assign specs_processor = product.metafields.specs.processor.value | default: product.metafields.custom.processor.value -%}
    {%- assign specs_ram = product.metafields.specs.ram.value | default: product.metafields.custom.ram.value -%}
    {%- assign specs_storage = product.metafields.specs.storage.value | default: product.metafields.custom.storage.value -%}
    {%- assign specs_display = product.metafields.specs.display.value | default: product.metafields.custom.display.value -%}
    {%- assign specs_battery = product.metafields.specs.battery.value | default: product.metafields.custom.battery.value -%}
    {%- assign specs_connectivity = product.metafields.specs.connectivity.value | default: product.metafields.custom.connectivity.value -%}
    {%- assign specs_weight = product.metafields.specs.weight.value | default: product.metafields.custom.weight.value -%}
    {%- assign specs_warranty = product.metafields.specs.warranty.value | default: product.metafields.custom.warranty.value -%}
    {%- assign specs_compatibility = product.metafields.specs.compatibility.value | default: product.metafields.custom.compatibility.value -%}
    {%- assign specs_water_resistance = product.metafields.specs.water_resistance.value | default: product.metafields.custom.water_resistance.value -%}
    {%- assign has_any_spec = false -%}
    {%- if specs_processor != blank or specs_ram != blank or specs_storage != blank or specs_display != blank or specs_battery != blank or specs_connectivity != blank or specs_weight != blank or specs_warranty != blank or specs_compatibility != blank or specs_water_resistance != blank -%}
      {%- assign has_any_spec = true -%}
    {%- endif -%}

    {%- if section.settings.enable_specifications and has_any_spec -%}
      <div class="ncf-pdp-accordion-group py-2" data-accordion-item>
        <button
          type="button"
          class="w-full py-4 text-left flex items-center justify-between text-[#111827] hover:text-[#173D32] transition-colors focus:outline-none group"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="pdp-accordion-specs"
        >
          <span class="text-sm font-bold uppercase tracking-wider font-mono">Specifications</span>
          <span class="w-6 h-6 rounded-full flex items-center justify-center text-[#111827] group-hover:text-[#173D32] transition-transform duration-200" data-accordion-icon aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-minus hidden"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-plus"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </span>
        </button>

        <div
          id="pdp-accordion-specs"
          role="region"
          class="ncf-pdp-accordion-content pb-5 pt-1 text-xs sm:text-sm hidden"
        >
          {% render 'product-specification-table', product: product %}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 3. WHAT'S IN THE BOX (Only shown when structured data exists) {%- endcomment -%}
    {%- if box_contents != blank -%}
      <div class="ncf-pdp-accordion-group py-2" data-accordion-item>
        <button
          type="button"
          class="w-full py-4 text-left flex items-center justify-between text-[#111827] hover:text-[#173D32] transition-colors focus:outline-none group"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="pdp-accordion-box"
        >
          <span class="text-sm font-bold uppercase tracking-wider font-mono">What's in the Box</span>
          <span class="w-6 h-6 rounded-full flex items-center justify-center text-[#111827] group-hover:text-[#173D32] transition-transform duration-200" data-accordion-icon aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-minus hidden"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-plus"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </span>
        </button>

        <div
          id="pdp-accordion-box"
          role="region"
          class="ncf-pdp-accordion-content pb-5 pt-1 text-xs sm:text-sm text-[#111827] hidden"
        >
          <div class="p-4 rounded-xl bg-[#F7F8F6] border border-[#E5E7E5] text-xs text-[#111827] space-y-1.5">
            {{ box_contents }}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 4. SHIPPING & RETURNS (Dynamic from policies or settings) {%- endcomment -%}
    {%- assign shipping_info = product.metafields.custom.shipping_policy.value | default: shop.shipping_policy.body | default: section.settings.shipping_policy_content -%}
    {%- assign return_info = product.metafields.custom.return_policy.value | default: shop.refund_policy.body | default: section.settings.returns_policy_content -%}
    {%- if section.settings.enable_shipping and shipping_info != blank or return_info != blank -%}
      <div class="ncf-pdp-accordion-group py-2" data-accordion-item>
        <button
          type="button"
          class="w-full py-4 text-left flex items-center justify-between text-[#111827] hover:text-[#173D32] transition-colors focus:outline-none group"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="pdp-accordion-shipping"
        >
          <span class="text-sm font-bold uppercase tracking-wider font-mono">Shipping & Returns</span>
          <span class="w-6 h-6 rounded-full flex items-center justify-center text-[#111827] group-hover:text-[#173D32] transition-transform duration-200" data-accordion-icon aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-minus hidden"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-plus"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </span>
        </button>

        <div
          id="pdp-accordion-shipping"
          role="region"
          class="ncf-pdp-accordion-content pb-5 pt-1 text-xs sm:text-sm text-[#667085] hidden space-y-3 leading-relaxed"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {%- if shipping_info != blank -%}
              <div class="p-3.5 rounded-xl bg-[#F7F8F6] border border-[#E5E7E5] space-y-1">
                <span class="font-bold text-[#111827] block text-xs">Shipping Terms</span>
                <div class="text-[11px] text-[#667085] prose-sm">{{ shipping_info }}</div>
              </div>
            {%- endif -%}
            {%- if return_info != blank -%}
              <div class="p-3.5 rounded-xl bg-[#F7F8F6] border border-[#E5E7E5] space-y-1">
                <span class="font-bold text-[#111827] block text-xs">Replacement & Return Policy</span>
                <div class="text-[11px] text-[#667085] prose-sm">{{ return_info }}</div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 5. WARRANTY (Dynamic from product metafield or settings) {%- endcomment -%}
    {%- assign final_warranty = warranty_info | default: section.settings.warranty_policy_content -%}
    {%- if section.settings.enable_warranty and final_warranty != blank -%}
      <div class="ncf-pdp-accordion-group py-2" data-accordion-item>
        <button
          type="button"
          class="w-full py-4 text-left flex items-center justify-between text-[#111827] hover:text-[#173D32] transition-colors focus:outline-none group"
          data-accordion-trigger
          aria-expanded="false"
          aria-controls="pdp-accordion-warranty"
        >
          <span class="text-sm font-bold uppercase tracking-wider font-mono">Warranty Policy</span>
          <span class="w-6 h-6 rounded-full flex items-center justify-center text-[#111827] group-hover:text-[#173D32] transition-transform duration-200" data-accordion-icon aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-minus hidden"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-icon-plus"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </span>
        </button>

        <div
          id="pdp-accordion-warranty"
          role="region"
          class="ncf-pdp-accordion-content pb-5 pt-1 text-xs sm:text-sm text-[#667085] hidden space-y-3 leading-relaxed"
        >
          <div class="p-4 rounded-xl bg-[#EAF1EE] border border-[#173D32]/20 space-y-1">
            <span class="font-bold text-[#173D32] text-xs block">Official Warranty Coverage</span>
            <div class="text-[11px] text-[#111827]/80 leading-relaxed prose-sm">
              {{ final_warranty }}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</div>
