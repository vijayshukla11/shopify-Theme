{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Premium Product Tabs
  File: sections/product-tabs.liquid
  Sprint: 2.5 - Premium Product Tabs
  Architecture: Reusable Product Card System Integration & ARIA Tablist Engine
{%- endcomment -%}

{%- assign desktop_cols = section.settings.columns_desktop | default: 4 -%}
{%- assign mobile_cols = section.settings.columns_mobile | default: '2' -%}

<section
  class="ncf-product-tabs-section"
  id="ncf-product-tabs-{{ section.id }}"
  data-product-tabs-section
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#0f172a' }};
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  "
  aria-label="{{ section.settings.accessibility_label | default: 'Product Collections Showcase' }}"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    {%- comment -%} 1. SECTION HEADER {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="ncf-product-tabs__header text-{{ section.settings.header_alignment | default: 'center' }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="inline-block text-xs font-mono font-extrabold uppercase tracking-widest text-sky-600 mb-2">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 uppercase">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="text-slate-600 text-sm sm:text-base max-w-2xl mt-2 {% if section.settings.header_alignment == 'center' %}mx-auto{% endif %}">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} 2. ACCESSIBLE TAB NAVIGATION BAR {%- endcomment -%}
    <div class="ncf-product-tabs__nav-wrapper">
      <div
        class="ncf-product-tabs__tablist ncf-product-tabs__tablist--align-{{ section.settings.tab_alignment | default: 'center' }}"
        role="tablist"
        aria-label="{{ section.settings.heading | default: 'Product Categories' }}"
      >
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign is_first = forloop.first -%}
            <button
              type="button"
              role="tab"
              id="tab-{{ section.id }}-{{ block.id }}"
              aria-controls="panel-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if is_first %}true{% else %}false{% endif %}"
              tabindex="{% if is_first %}0{% else %}-1{% endif %}"
              class="ncf-product-tabs__tab {% if is_first %}is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span>{{ block.settings.title | default: 'Tab Title' }}</span>
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} DEFAULT FALLBACK TABS FOR EDITOR {%- endcomment -%}
          <button type="button" role="tab" id="tab-{{ section.id }}-preset1" aria-controls="panel-{{ section.id }}-preset1" aria-selected="true" tabindex="0" class="ncf-product-tabs__tab is-active">
            <span>Featured Products</span>
          </button>
          <button type="button" role="tab" id="tab-{{ section.id }}-preset2" aria-controls="panel-{{ section.id }}-preset2" aria-selected="false" tabindex="-1" class="ncf-product-tabs__tab">
            <span>New Arrivals</span>
          </button>
          <button type="button" role="tab" id="tab-{{ section.id }}-preset3" aria-controls="panel-{{ section.id }}-preset3" aria-selected="false" tabindex="-1" class="ncf-product-tabs__tab">
            <span>Best Sellers</span>
          </button>
        {%- endif -%}

        {%- comment -%} Sliding Accent Underline Indicator {%- endcomment -%}
        <div class="ncf-product-tabs__indicator" data-tab-indicator aria-hidden="true"></div>
      </div>
    </div>

    {%- comment -%} 3. TAB PANELS CONTENT {%- endcomment -%}
    <div class="ncf-product-tabs__panels">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign is_first = forloop.first -%}
          {%- assign tab_collection = block.settings.collection -%}
          {%- assign product_limit = block.settings.products_to_show | default: 8 -%}

          <div
            id="panel-{{ section.id }}-{{ block.id }}"
            role="tabpanel"
            aria-labelledby="tab-{{ section.id }}-{{ block.id }}"
            class="ncf-product-tabs__panel {% if is_first %}is-active{% endif %}"
            {% unless is_first %}hidden{% endunless %}
          >
            <div class="grid gap-6 grid-cols-{{ mobile_cols }} sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-{{ desktop_cols }}">
              {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
                {%- for product in tab_collection.products limit: product_limit -%}
                  {% render 'product-card',
                    product: product,
                    card_style: section.settings.card_style,
                    media_aspect_ratio: section.settings.media_aspect_ratio,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    show_badges: section.settings.show_badges,
                    show_quick_view: section.settings.show_quick_view,
                    show_wishlist: section.settings.show_wishlist,
                    show_compare: section.settings.show_compare,
                    show_add_to_cart: section.settings.show_add_to_cart,
                    hover_animation: section.settings.hover_animation
                  %}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} PLACEHOLDER CARDS FOR EMPTY COLLECTION / EDITOR PREVIEW {%- endcomment -%}
                {%- for i in (1..product_limit) -%}
                  <div class="ncf-product-card ncf-product-card--{{ section.settings.card_style | default: 'classic' }}">
                    <div class="ncf-product-card__media-wrapper aspect-[3/4]">
                      {{ 'product-1' | placeholder_svg_tag: 'ncf-product-card__placeholder' }}
                    </div>
                    <div class="ncf-product-card__details">
                      <div class="ncf-product-card__vendor">NOVA AUDIO</div>
                      <h3 class="ncf-product-card__title">
                        <a href="#" class="ncf-product-card__title-link">{{ block.settings.title }} Product #{{ i }}</a>
                      </h3>
                      <div class="ncf-price font-mono font-bold text-sky-600">$189.00</div>
                    </div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>

            {%- comment -%} View All Collection Link Button {%- endcomment -%}
            {%- if section.settings.show_view_all and tab_collection != blank -%}
              <div class="text-center mt-12">
                <a href="{{ tab_collection.url }}" class="ncf-btn ncf-btn--primary">
                  <span>View All {{ tab_collection.title }}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} DEFAULT PANELS FALLBACK {%- endcomment -%}
        <div id="panel-{{ section.id }}-preset1" role="tabpanel" aria-labelledby="tab-{{ section.id }}-preset1" class="ncf-product-tabs__panel is-active">
          <div class="grid gap-6 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {%- for i in (1..4) -%}
              <div class="ncf-product-card ncf-product-card--classic">
                <div class="ncf-product-card__media-wrapper aspect-[3/4]">
                  {{ 'product-1' | placeholder_svg_tag: 'ncf-product-card__placeholder' }}
                </div>
                <div class="ncf-product-card__details">
                  <div class="ncf-product-card__vendor">NOVA HARDWARE</div>
                  <h3 class="ncf-product-card__title">
                    <a href="#" class="ncf-product-card__title-link">Featured Product #{{ i }}</a>
                  </h3>
                  <div class="ncf-price font-mono font-bold text-sky-600">$149.00</div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Premium Product Tabs",
  "tag": "section",
  "class": "section-product-tabs",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "EXPLORE OUR CATALOG"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Trending Categories"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Description",
      "default": "Browse curated product collections engineered for high performance and durability."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Center Aligned" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Tab Navigation Layout"
    },
    {
      "type": "select",
      "id": "tab_alignment",
      "label": "Tab Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Center Aligned" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Grid & Card Options"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Product Card Style",
      "options": [
        { "value": "classic", "label": "Classic (Clean Border & Shadow)" },
        { "value": "minimal", "label": "Minimal (Flat Transparent)" },
        { "value": "bordered", "label": "Bordered (Thick Accent Border)" },
        { "value": "luxury", "label": "Luxury (Dark Premium Gloss)" },
        { "value": "compact", "label": "Compact (High Density Grid)" }
      ],
      "default": "classic"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Media Aspect Ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "adapt", "label": "Adapt to Image" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "hover_animation",
      "label": "Hover Animation Effect",
      "options": [
        { "value": "zoom", "label": "Image Scale Zoom" },
        { "value": "lift", "label": "Card Translate Lift" },
        { "value": "none", "label": "None" }
      ],
      "default": "zoom"
    },
    {
      "type": "header",
      "content": "Card Features Toggles"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show Secondary Image on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor Title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Star Ratings",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show Badges (Sale/New/Sold Out)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Show Quick View Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Toggle Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show Compare Toggle Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Quick Add To Cart Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button below Tab Grid",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors & Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 8,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 8,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility Region Label",
      "default": "Product Collections Showcase"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Product Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Name",
          "default": "Featured"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 2,
          "max": 12,
          "step": 1,
          "label": "Products to Show",
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Product Tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "Featured"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "New Arrivals"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Best Sellers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
