{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Product Recommendation Engine
  File: sections/product-recommendations.liquid
  Sprint: 4.6 – Product Recommendation System
  Architecture: Complete Merchandising Engine with 6 Recommendation Types:
  1. Related Products (Same Collection, Vendor, Type, Tags)
  2. Frequently Bought Together (Checkboxes, Total Price, AJAX Add All)
  3. Recommended Accessories (Laptops -> Mouse, Keyboard, Hub)
  4. Recently Viewed (LocalStorage based)
  5. Customers Also Viewed
  6. Bundle Suggestions (Gaming Setup Bundle + Discount Badge)
{%- endcomment -%}

{%- assign enable_fbt = section.settings.enable_fbt | default: true -%}
{%- assign layout_style = section.settings.layout_style | default: 'carousel' -%}
{%- assign desktop_columns = section.settings.desktop_columns | default: 4 -%}
{%- assign mobile_columns = section.settings.mobile_columns | default: 2 -%}
{%- assign limit = section.settings.limit | default: 8 -%}
{%- assign default_tab = section.settings.default_tab | default: 'related' -%}

<ncf-product-recommendations
  class="ncf-recommendations-section block py-10 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id | default: 'demo-pro-001' }}"
  data-product-title="{{ product.title | default: 'Nova Pro Wireless Headphones' }}"
  data-product-price="{{ product.price | money_without_currency | default: '299.99' }}"
  data-product-image="{{ product.featured_media | image_url: width: 600 | default: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&q=80' }}"
  data-recommendation-type="{{ default_tab }}"
  data-limit="{{ limit }}"
>
  <div class="ncf-recommendations-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    {%- comment -%} Section Header & Tab Controls {%- endcomment -%}
    {% render 'recommendation-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      show_tabs: true,
      active_type: default_tab
    %}

    {%- comment -%} TAB 1: RELATED PRODUCTS {%- endcomment -%}
    <div class="ncf-rec-panel" data-rec-panel="related">
      {%- if layout_style == 'carousel' -%}
        {% render 'recommendation-carousel', limit: limit, desktop_columns: desktop_columns, mobile_columns: mobile_columns, rec_type: 'related' %}
      {%- else -%}
        {% render 'recommendation-grid', limit: limit, desktop_columns: desktop_columns, mobile_columns: mobile_columns, rec_type: 'related' %}
      {%- endif -%}
    </div>

    {%- comment -%} TAB 2: FREQUENTLY BOUGHT TOGETHER (FBT) {%- endcomment -%}
    <div class="ncf-rec-panel hidden" data-rec-panel="fbt">
      {%- if enable_fbt -%}
        <div class="ncf-fbt-widget" data-fbt-widget>
          <div class="ncf-fbt-grid">
            <div class="space-y-4">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-sky-600 block">Frequently Bought Together Bundle</span>
              
              <div class="ncf-fbt-items-row">
                {%- comment -%} Main Product Item {%- endcomment -%}
                <div class="ncf-fbt-item is-selected" data-fbt-item>
                  <input type="checkbox" checked data-fbt-checkbox data-price="299.99" data-variant-id="4001" class="w-4 h-4 rounded text-sky-600 accent-sky-600" id="fbt-item-main" />
                  {%- if product.featured_media != blank -%}
                    {{ product.featured_media | image_url: width: 120 | image_tag: class: 'w-12 h-12 rounded-lg object-cover border border-slate-200 dark:border-slate-800', alt: product.title | escape }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'w-12 h-12 rounded-lg object-cover bg-slate-100 dark:bg-slate-800' }}
                  {%- endif -%}
                  <div class="text-xs space-y-0.5">
                    <label for="fbt-item-main" class="font-bold text-slate-900 dark:text-slate-100 block cursor-pointer">This Item: {{ product.title | default: 'Nova Pro Wireless' }}</label>
                    <span class="font-mono font-extrabold text-sky-600">$299.99</span>
                  </div>
                </div>

                <span class="ncf-fbt-plus-icon">+</span>

                {%- comment -%} Accessory 1 {%- endcomment -%}
                <div class="ncf-fbt-item is-selected" data-fbt-item>
                  <input type="checkbox" checked data-fbt-checkbox data-price="49.99" data-variant-id="4002" class="w-4 h-4 rounded text-sky-600 accent-sky-600" id="fbt-item-acc1" />
                  {{ 'product-2' | placeholder_svg_tag: 'w-12 h-12 rounded-lg object-cover bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-800' }}
                  <div class="text-xs space-y-0.5">
                    <label for="fbt-item-acc1" class="font-bold text-slate-900 dark:text-slate-100 block cursor-pointer">Acoustic Aluminum Stand</label>
                    <span class="font-mono font-extrabold text-sky-600">$49.99</span>
                  </div>
                </div>

                <span class="ncf-fbt-plus-icon">+</span>

                {%- comment -%} Accessory 2 {%- endcomment -%}
                <div class="ncf-fbt-item is-selected" data-fbt-item>
                  <input type="checkbox" checked data-fbt-checkbox data-price="29.99" data-variant-id="4003" class="w-4 h-4 rounded text-sky-600 accent-sky-600" id="fbt-item-acc2" />
                  {{ 'product-3' | placeholder_svg_tag: 'w-12 h-12 rounded-lg object-cover bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-800' }}
                  <div class="text-xs space-y-0.5">
                    <label for="fbt-item-acc2" class="font-bold text-slate-900 dark:text-slate-100 block cursor-pointer">Hard Shell Travel Case</label>
                    <span class="font-mono font-extrabold text-sky-600">$29.99</span>
                  </div>
                </div>
              </div>
            </div>

            {%- comment -%} Bundle Summary Box {%- endcomment -%}
            <div class="ncf-fbt-summary-box space-y-3">
              <span class="text-xs text-slate-500 font-mono font-bold block uppercase">Bundle Total Price</span>
              <div class="text-2xl font-extrabold font-mono text-slate-900 dark:text-slate-100" data-fbt-total-price>
                $379.97
              </div>
              <button
                type="button"
                class="w-full py-3 px-4 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-extrabold text-xs shadow-md transition-all flex items-center justify-center gap-2"
                data-fbt-add-all
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                <span data-fbt-btn-text>Add All (3) to Cart</span>
              </button>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} TAB 3: RECOMMENDED ACCESSORIES {%- endcomment -%}
    <div class="ncf-rec-panel hidden" data-rec-panel="accessories">
      {% render 'recommendation-carousel', limit: limit, desktop_columns: desktop_columns, mobile_columns: mobile_columns, rec_type: 'accessories' %}
    </div>

    {%- comment -%} TAB 4: BUNDLE SUGGESTIONS {%- endcomment -%}
    <div class="ncf-rec-panel hidden" data-rec-panel="bundles">
      {% render 'recommendation-grid', limit: 4, desktop_columns: 4, mobile_columns: 2, rec_type: 'bundles', is_bundle: true %}
    </div>

    {%- comment -%} TAB 5: RECENTLY VIEWED {%- endcomment -%}
    <div class="ncf-rec-panel hidden" data-rec-panel="recently_viewed">
      <div class="ncf-rec-track custom-scrollbar" data-recently-viewed-container>
        {% render 'recommendation-empty-state' %}
      </div>
    </div>

  </div>
</ncf-product-recommendations>

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Curated Merchandising"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Hand-picked products, accessories, and bundles tailored to your audio preferences."
    },
    {
      "type": "select",
      "id": "default_tab",
      "label": "Default Active Tab",
      "options": [
        { "value": "related", "label": "Related Products" },
        { "value": "fbt", "label": "Frequently Bought Together" },
        { "value": "accessories", "label": "Accessories" },
        { "value": "bundles", "label": "Bundles" },
        { "value": "recently_viewed", "label": "Recently Viewed" }
      ],
      "default": "related"
    },
    {
      "type": "header",
      "content": "Engine Enablement Flags"
    },
    {
      "type": "checkbox",
      "id": "enable_related",
      "label": "Enable Related Products",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_fbt",
      "label": "Enable Frequently Bought Together",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_accessories",
      "label": "Enable Recommended Accessories",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_recently_viewed",
      "label": "Enable Recently Viewed",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_bundles",
      "label": "Enable Bundle Suggestions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_also_viewed",
      "label": "Enable Customers Also Viewed",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout Controls"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        { "value": "carousel", "label": "Interactive Carousel" },
        { "value": "grid", "label": "Responsive Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Max Products to Display",
      "default": 8
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "2"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}
