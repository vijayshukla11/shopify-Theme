{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Premium Refined Hero Banner
  File: sections/hero-banner.liquid
  Sprint: 2.2A - Premium UI Refinement
{%- endcomment -%}

{%- assign slide_count = section.blocks.size -%}

<div
  class="ncf-hero ncf-hero--height-{{ section.settings.desktop_height }} ncf-hero--effect-{{ section.settings.transition_effect }}"
  data-ncf-hero
  data-effect="{{ section.settings.transition_effect }}"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
  data-speed="{{ section.settings.rotation_speed }}"
  role="region"
  aria-label="{{ section.settings.accessibility_title | default: 'Promotional Hero Slider' }}"
>
  {%- comment -%} Hero Slide Track Container {%- endcomment -%}
  <div class="ncf-hero__track" data-hero-track>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {% render 'hero-slide', block: block, forloop: forloop, total_slides: slide_count %}
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Default Preset Fallback Slide when Theme Editor initialized {%- endcomment -%}
      <div class="ncf-hero-slide is-active" data-hero-slide data-slide-index="0" role="group" aria-roledescription="slide" aria-label="1 of 1">
        <div class="ncf-hero-slide__media-wrapper">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'ncf-hero-slide__placeholder' }}
          <div class="ncf-hero-slide__overlay ncf-hero-slide__overlay--medium"></div>
        </div>
        <div class="ncf-hero-slide__container max-w-7xl">
          <div class="ncf-hero-slide__grid">
            <div class="ncf-hero-slide__content ncf-hero-slide__content--left">
              <div class="ncf-hero-slide__tag-row">
                <span class="ncf-hero-slide__badge">SUMMER 2026 ATELIER CAPSULE</span>
                <span class="ncf-hero-slide__eyebrow">PERFECTION EXISTS IN EVERY THREAD</span>
              </div>
              <h1 class="ncf-hero-slide__heading">
                THE LINEN EDIT
              </h1>
              <p class="ncf-hero-slide__description">
                Crafted from 100% pure European flax with single-needle tailoring for effortless Mediterranean ease.
              </p>
              <div class="ncf-hero-slide__actions">
                <a href="{{ routes.all_products_collection_url }}" class="ncf-btn ncf-btn--primary">
                  <span>SHOP NOW</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Previous / Next Arrow Controls {%- endcomment -%}
  {%- if section.settings.show_arrows and slide_count > 1 -%}
    <button
      type="button"
      class="ncf-hero__arrow ncf-hero__arrow--prev"
      data-hero-prev
      aria-label="{{ 'general.hero.previous_slide' | t | default: 'Previous Slide' }}"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button
      type="button"
      class="ncf-hero__arrow ncf-hero__arrow--next"
      data-hero-next
      aria-label="{{ 'general.hero.next_slide' | t | default: 'Next Slide' }}"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  {%- endif -%}

  {%- comment -%} Dot Indicators Pagination {%- endcomment -%}
  {%- if section.settings.show_dots and slide_count > 1 -%}
    <div class="ncf-hero__dots" role="tablist" aria-label="Hero Slide Controls">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="ncf-hero__dot {% if forloop.first %}is-active{% endif %}"
          data-hero-dot
          data-dot-index="{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="Go to slide {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Premium Hero Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Layout & Banner Height"
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Height",
      "options": [
        { "value": "sm", "label": "Compact (480px)" },
        { "value": "md", "label": "Balanced (600px)" },
        { "value": "lg", "label": "Expanded (720px)" },
        { "value": "full", "label": "Full Screen (100vh)" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "transition_effect",
      "label": "Slide Transition Effect",
      "options": [
        { "value": "slide", "label": "Horizontal Slide" },
        { "value": "fade", "label": "Cross Fade" }
      ],
      "default": "slide"
    },
    {
      "type": "header",
      "content": "Autoplay & Controls"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Auto-rotate Slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Auto-rotate on Hover/Focus",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Delay (Seconds)",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dot Pagination",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_title",
      "label": "Accessibility Label for Screen Readers",
      "default": "Promotional Hero Banner Carousel"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "header",
          "content": "Media Content"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Background Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Background Image (Optional)"
        },
        {
          "type": "image_picker",
          "id": "featured_product_image",
          "label": "Right Column Featured Product Image (Optional)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Background Video (Overrides Image)"
        },
        {
          "type": "select",
          "id": "overlay_preset",
          "label": "Background Overlay Contrast",
          "options": [
            { "value": "none", "label": "None (0%)" },
            { "value": "light", "label": "Light (20%)" },
            { "value": "medium", "label": "Medium (40%)" },
            { "value": "dark", "label": "Dark (65%)" }
          ],
          "default": "medium"
        },
        {
          "type": "header",
          "content": "Slide Copy & Typography"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Tag",
          "default": "LIMITED EDITION"
        },
        {
          "type": "text",
          "id": "eyebrow_text",
          "label": "Eyebrow Text",
          "default": "WIRELESS AUDIO"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Title",
          "default": "Nova Sound Pro ANC"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description Text",
          "default": "Custom 45mm beryllium drivers with hybrid active noise cancellation and spatial audio processing."
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price Display",
          "default": "$299.99"
        },
        {
          "type": "text",
          "id": "compare_price_text",
          "label": "Compare Price (Optional)",
          "default": "$349.99"
        },
        {
          "type": "text",
          "id": "feature_list",
          "label": "Spec Tag Pills (Comma Separated)",
          "default": "40H Battery, Beryllium Driver, ANC 2.0"
        },
        {
          "type": "header",
          "content": "Buttons & Links"
        },
        {
          "type": "text",
          "id": "primary_button_label",
          "label": "Primary Button Text",
          "default": "Shop Flagship Headphones"
        },
        {
          "type": "url",
          "id": "primary_button_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_button_label",
          "label": "Secondary Button Text",
          "default": "Read Technical Specs"
        },
        {
          "type": "url",
          "id": "secondary_button_link",
          "label": "Secondary Button Link"
        },
        {
          "type": "header",
          "content": "Content Alignment"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Text & Content Alignment",
          "options": [
            { "value": "left", "label": "Left Aligned" },
            { "value": "center", "label": "Center Aligned" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Hero Banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "badge_text": "LIMITED EDITION",
            "eyebrow_text": "WIRELESS AUDIO",
            "heading": "NOVA SOUND PRO ANC",
            "description": "Custom 45mm beryllium drivers with hybrid noise cancelling technology and spatial audio processing.",
            "price_text": "$299.99",
            "compare_price_text": "$349.99",
            "feature_list": "40H Battery, Beryllium Driver, ANC 2.0",
            "primary_button_label": "Shop Flagship Headphones",
            "secondary_button_label": "Read Technical Specs",
            "overlay_preset": "medium",
            "content_alignment": "left"
          }
        },
        {
          "type": "slide",
          "settings": {
            "badge_text": "NEW RELEASE",
            "eyebrow_text": "CREATIVE PERFORMANCE",
            "heading": "NOVABOOK ULTRA 16\" OLED",
            "description": "Powered by M3 Max architecture with 120Hz Liquid Retina XDR screen for relentless creative speed.",
            "price_text": "$2,499.00",
            "feature_list": "M3 Max Chip, 32GB RAM, 120Hz OLED",
            "primary_button_label": "Configure Laptop",
            "secondary_button_label": "Compare Models",
            "overlay_preset": "light",
            "content_alignment": "left"
          }
        }
      ]
    }
  ]
}
{% endschema %}
