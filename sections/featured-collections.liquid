{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Premium Featured Collections
  File: sections/featured-collections.liquid
  Sprint: 2.7 – Premium Featured Collections
  Architecture: Mobile-First Editorial Collection Showcase Engine
{%- endcomment -%}

{%- assign layout_variant = section.settings.layout_variant | default: 'editorial' -%}
{%- assign container_type = section.settings.container_type | default: 'container' -%}

<section
  class="ncf-featured-collections-section {% if container_type == 'full' %}ncf-featured-collections-section--full-width{% endif %}"
  id="ncf-featured-collections-{{ section.id }}"
  data-featured-collections-section
  style="
    background-color: {{ section.settings.bg_color | default: '#ffffff' }};
    padding-top: {{ section.settings.padding_top | default: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  "
  aria-label="{{ section.settings.heading | default: 'Featured Collections' }}"
>
  <div class="{% if container_type == 'container' %}max-w-7xl mx-auto px-6 lg:px-8{% else %}w-full px-0{% endif %}">

    {%- comment -%} SECTION HEADER {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="ncf-featured-collections__header text-{{ section.settings.header_alignment | default: 'center' }} mb-10 {% if container_type == 'full' %}px-6 lg:px-8{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="inline-block text-xs font-mono font-extrabold uppercase tracking-widest text-sky-600 mb-2">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 uppercase">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="text-slate-600 text-sm sm:text-base max-w-2xl mt-2 {% if section.settings.header_alignment == 'center' %}mx-auto{% endif %}">
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} FEATURED COLLECTIONS GRID {%- endcomment -%}
    <div class="ncf-collections-grid ncf-collections-grid--{{ layout_variant }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% render 'collection-card', block: block, section: section %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} DEFAULT FALLBACK CARDS FOR EDITOR PREVIEW {%- endcomment -%}
        {%- for i in (1..3) -%}
          <article class="ncf-collection-card ncf-collection-card--height-medium">
            <div class="ncf-collection-card__media">
              {{ 'collection-1' | placeholder_svg_tag: 'ncf-collection-card__img' }}
            </div>
            <div class="ncf-collection-card__overlay"></div>
            <div class="ncf-collection-card__content">
              <div class="ncf-collection-card__header-meta">
                <span class="ncf-collection-card__badge">FEATURED</span>
                <span class="ncf-collection-card__count">48 Products</span>
              </div>
              <h3 class="ncf-collection-card__title">Curated Collection #{{ i }}</h3>
              <p class="ncf-collection-card__description">High-performance gear engineered for extreme conditions and peak versatility.</p>
              <div class="ncf-collection-card__actions">
                <a href="#" class="ncf-collection-btn ncf-collection-btn--primary">
                  <span>Explore Collection</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-featured-collections",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "CURATED CATALOG"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Collections"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Explore our handpicked equipment and apparel series engineered for high performance."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Center Aligned" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout & Container"
    },
    {
      "type": "select",
      "id": "layout_variant",
      "label": "Grid Layout Style",
      "options": [
        { "value": "editorial", "label": "Editorial Grid (Asymmetric Asymmetrical Spans)" },
        { "value": "masonry", "label": "Masonry Grid (Staggered Offset Height)" },
        { "value": "two-column", "label": "Two Column Grid (Equal)" },
        { "value": "three-column", "label": "Three Column Grid (Equal)" },
        { "value": "feature-card", "label": "Feature Hero Card (1 Main + Sub Cards)" },
        { "value": "magazine-layout", "label": "Magazine Layout (Full Banner Top + Grid)" }
      ],
      "default": "editorial"
    },
    {
      "type": "select",
      "id": "container_type",
      "label": "Container Width",
      "options": [
        { "value": "container", "label": "Standard Boxed Container (Max 1280px)" },
        { "value": "full", "label": "Full Width (Edge-to-Edge)" }
      ],
      "default": "container"
    },
    {
      "type": "select",
      "id": "card_height",
      "label": "Default Card Height",
      "options": [
        { "value": "small", "label": "Small (280px / 320px)" },
        { "value": "medium", "label": "Medium (360px / 420px)" },
        { "value": "large", "label": "Large (480px / 540px)" },
        { "value": "hero", "label": "Hero (580px / 640px)" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "header",
          "content": "Collection Selection"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Card Badge Text",
          "default": "NEW ARRIVAL"
        },
        {
          "type": "checkbox",
          "id": "show_product_count",
          "label": "Show Product Count Badge",
          "default": true
        },
        {
          "type": "header",
          "content": "Content Overrides"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Custom Card Heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Custom Card Description"
        },
        {
          "type": "header",
          "content": "Media Uploads"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Background Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Background Image"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Dark Overlay Opacity",
          "default": 45
        },
        {
          "type": "header",
          "content": "CTA Buttons"
        },
        {
          "type": "text",
          "id": "btn_primary_text",
          "label": "Primary Button Label",
          "default": "Explore Collection"
        },
        {
          "type": "url",
          "id": "btn_primary_url",
          "label": "Primary Button Custom Link"
        },
        {
          "type": "text",
          "id": "btn_secondary_text",
          "label": "Secondary Button Label"
        },
        {
          "type": "url",
          "id": "btn_secondary_url",
          "label": "Secondary Button Link"
        },
        {
          "type": "header",
          "content": "Styling"
        },
        {
          "type": "select",
          "id": "card_height",
          "label": "Card Height Override",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "hero", "label": "Hero" }
          ],
          "default": "medium"
        },
        {
          "type": "color",
          "id": "card_bg_color",
          "label": "Card Background Color",
          "default": "#0f172a"
        },
        {
          "type": "color",
          "id": "card_text_color",
          "label": "Card Text Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "badge_text": "POPULAR",
            "heading": "Acoustic Audio Series"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "badge_text": "LIMITED EDITION",
            "heading": "Tactical Wearables"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "badge_text": "NEW RELEASE",
            "heading": "Precision Accessories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
