{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Main Cart Page
  File: sections/main-cart.liquid
  Sprint: 5.0 – Production Shopify Live Cart Drawer & Checkout Integration
{%- endcomment -%}

<section
  id="main-cart-{{ section.id }}"
  class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12"
  aria-label="{{ 'templates.cart.cart' | t | default: 'Shopping Cart' }}"
>
  <div class="max-w-6xl mx-auto">
    
    {%- comment -%} Header {%- endcomment -%}
    <div class="flex items-center justify-between pb-6 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
          Shopping Cart
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          {%- if cart.item_count == 1 -%}
            1 item currently in your bag
          {%- else -%}
            {{ cart.item_count }} items currently in your bag
          {%- endif -%}
        </p>
      </div>

      <a
        href="{{ routes.all_products_collection_url | default: '/collections/all' }}"
        class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-[#2563EB] hover:text-blue-700 dark:text-sky-400 dark:hover:text-sky-300 transition-colors"
      >
        <span>Continue Shopping</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        {%- comment -%} Left Column: Cart Items List {%- endcomment -%}
        <div class="lg:col-span-8 space-y-6">
          <div class="divide-y divide-slate-200 dark:divide-slate-800 border-y border-slate-200 dark:border-slate-800">
            {%- for item in cart.items -%}
              <div class="py-6 flex gap-4 sm:gap-6 items-start">
                
                {%- comment -%} Thumbnail {%- endcomment -%}
                <div class="w-20 h-20 sm:w-28 sm:h-28 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 overflow-hidden flex-shrink-0 flex items-center justify-center p-2">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 240 }}"
                      alt="{{ item.title | escape }}"
                      loading="lazy"
                      class="w-full h-full object-contain"
                      width="120"
                      height="120"
                    />
                  {%- else -%}
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-slate-400">
                      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    </svg>
                  {%- endif -%}
                </div>

                {%- comment -%} Info & Actions {%- endcomment -%}
                <div class="flex-1 min-w-0 flex flex-col justify-between self-stretch">
                  <div>
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        {%- if section.settings.show_vendor and item.product.vendor != blank -%}
                          <span class="text-xs font-bold uppercase tracking-wider text-[#2563EB] dark:text-sky-400 font-mono block">
                            {{ item.product.vendor }}
                          </span>
                        {%- endif -%}
                        <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 leading-snug">
                          <a href="{{ item.url }}" class="hover:text-[#2563EB] dark:hover:text-sky-400 transition-colors">
                            {{ item.product.title }}
                          </a>
                        </h2>
                      </div>

                      <a
                        href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                        class="text-slate-400 hover:text-rose-500 dark:hover:text-rose-400 p-1 rounded-lg transition-colors"
                        aria-label="Remove {{ item.product.title | escape }}"
                        title="Remove item"
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                      </a>
                    </div>

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-medium">
                        {{ item.variant.title }}
                      </p>
                    {%- endunless -%}

                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-mono">
                      Unit Price: {{ item.final_price | money }}
                    </p>
                  </div>

                  <div class="flex items-center justify-between pt-4 mt-auto">
                    {%- comment -%} Quantity Control {%- endcomment -%}
                    <div class="flex items-center rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-1">
                      <a
                        href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                        class="w-8 h-8 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center font-bold text-sm"
                        aria-label="Decrease quantity"
                      >
                        -
                      </a>
                      <input
                        type="number"
                        name="updates[]"
                        id="updates_{{ item.key }}"
                        value="{{ item.quantity }}"
                        min="0"
                        max="99"
                        class="w-12 text-center text-xs font-bold font-mono bg-transparent text-slate-800 dark:text-slate-200 focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                        aria-label="Quantity for {{ item.product.title | escape }}"
                      />
                      <a
                        href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                        class="w-8 h-8 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center justify-center font-bold text-sm"
                        aria-label="Increase quantity"
                      >
                        +
                      </a>
                    </div>

                    {%- comment -%} Line Total {%- endcomment -%}
                    <div class="text-right">
                      <span class="text-base sm:text-lg font-extrabold text-slate-900 dark:text-slate-100 font-mono">
                        {{ item.final_line_price | money }}
                      </span>
                      {%- if item.original_line_price > item.final_line_price -%}
                        <span class="text-xs text-slate-400 line-through block font-mono">
                          {{ item.original_line_price | money }}
                        </span>
                      {%- endif -%}
                    </div>
                  </div>

                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- comment -%} Cart Order Note {%- endcomment -%}
          {%- if section.settings.show_notes -%}
            <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-2">
              <label for="CartNote" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 font-mono block">
                Order Special Instructions / Delivery Notes:
              </label>
              <textarea
                name="note"
                id="CartNote"
                rows="3"
                class="w-full p-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
                placeholder="Special notes or dispatch instructions..."
              >{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Right Column: Order Summary {%- endcomment -%}
        <div class="lg:col-span-4">
          <div class="p-6 sm:p-8 rounded-3xl bg-[#F8FAFC] dark:bg-slate-850 border border-slate-200 dark:border-slate-800 space-y-6 sticky top-24 shadow-2xs">
            <h2 class="text-lg font-extrabold text-slate-900 dark:text-slate-100 tracking-tight border-b border-slate-200 dark:border-slate-800 pb-4">
              Order Summary
            </h2>

            <div class="space-y-3 text-sm">
              <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
                <span>Subtotal</span>
                <span class="font-bold text-slate-900 dark:text-slate-100 font-mono">
                  {{ cart.total_price | money }}
                </span>
              </div>
              <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
                <span>Estimated Shipping</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-semibold text-xs">
                  {%- if cart.total_price >= 99900 -%}
                    FREE Express Delivery
                  {%- else -%}
                    Calculated at checkout
                  {%- endif -%}
                </span>
              </div>
              <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
                <span>Estimated Taxes</span>
                <span class="text-slate-400 text-xs">Included in price</span>
              </div>

              <div class="pt-3 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-base font-extrabold text-slate-900 dark:text-slate-100">
                <span>Total</span>
                <span class="text-xl text-[#111111] dark:text-white font-mono">
                  {{ cart.total_price | money }}
                </span>
              </div>
            </div>

            <div class="space-y-3 pt-2">
              <button
                type="submit"
                name="checkout"
                class="w-full py-4 px-6 rounded-xs bg-[#111111] hover:bg-neutral-800 active:scale-98 text-white font-bold text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>PROCEED TO CHECKOUT</span>
              </button>

              <button
                type="submit"
                name="update"
                class="w-full py-2.5 text-center text-xs font-bold text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-slate-200 transition-colors"
              >
                Update Cart Quantities
              </button>
            </div>

            {%- comment -%} Trust Badges {%- endcomment -%}
            <div class="pt-4 border-t border-slate-200 dark:border-slate-800 space-y-2 text-xs text-slate-500 dark:text-slate-400">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>30-Day Money-Back Guarantee</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-sky-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Official TechNova Brand Warranty Included</span>
              </div>
            </div>

          </div>
        </div>

      </form>
    {%- else -%}
      {%- comment -%} Empty Cart State {%- endcomment -%}
      <div class="py-16 sm:py-24 text-center max-w-md mx-auto space-y-4">
        <div class="w-20 h-20 rounded-3xl bg-slate-100 dark:bg-slate-800 text-slate-400 flex items-center justify-center mx-auto">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
          Your shopping cart is empty
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          Explore our collection of flagship wireless headphones, true wireless earbuds, and precision accessories.
        </p>
        <div class="pt-4">
          <a
            href="{{ routes.all_products_collection_url | default: '/collections/all' }}"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-[#2563EB] hover:bg-blue-700 text-white font-bold text-sm shadow-md transition-all"
          >
            <span>Start Shopping</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "tag": "section",
  "class": "ncf-section-main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Product Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Enable Cart Notes",
      "default": true
    }
  ]
}
{% endschema %}
