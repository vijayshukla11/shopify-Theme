{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Trust & Service Features
  File: sections/service-features.liquid
  Sprint: 2.3 - Trust & Service Features
{%- endcomment -%}

{%- assign desktop_cols = section.settings.columns_desktop | default: 4 -%}
{%- assign mobile_cols = section.settings.columns_mobile | default: 1 -%}
{%- assign card_style = section.settings.card_style | default: 'bordered' -%}
{%- assign card_align = section.settings.card_alignment | default: 'left' -%}

<section
  class="ncf-service-section"
  id="ncf-service-features-{{ section.id }}"
  style="
    --ncf-sf-bg-color: {{ section.settings.bg_color | default: '#ffffff' }};
    --ncf-sf-text-main: {{ section.settings.text_color | default: '#0f172a' }};
    --ncf-sf-accent: {{ section.settings.accent_color | default: '#0284c7' }};
    --ncf-sf-padding-top: {{ section.settings.padding_top | default: 56 }}px;
    --ncf-sf-padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px;
  "
  aria-label="{{ section.settings.accessibility_label | default: 'Store Guarantees & Service Features' }}"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    
    {%- comment -%} 1. SECTION HEADER (OPTIONAL) {%- endcomment -%}
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="ncf-service-header ncf-service-header--{{ section.settings.header_alignment | default: 'center' }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ncf-service-header__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="ncf-service-header__title">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="ncf-service-header__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} 2. DYNAMIC SERVICE CARDS GRID {%- endcomment -%}
    <div class="ncf-service-grid ncf-service-grid--cols-{{ desktop_cols }} ncf-service-grid--mobile-{{ mobile_cols }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {% render 'service-feature-card', block: block, card_style: card_style, card_align: card_align %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} DEFAULT PLACEHOLDERS FOR THEME EDITOR INITIATION {%- endcomment -%}
        <div class="ncf-service-card ncf-service-card--{{ card_style }} ncf-service-card--align-{{ card_align }}">
          <div class="ncf-service-card__icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13" rx="2"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          </div>
          <div class="ncf-service-card__content">
            <h3 class="ncf-service-card__title">Free Global Shipping</h3>
            <p class="ncf-service-card__description">Complimentary express delivery on all orders over $50 worldwide.</p>
          </div>
        </div>
        <div class="ncf-service-card ncf-service-card--{{ card_style }} ncf-service-card--align-{{ card_align }}">
          <div class="ncf-service-card__icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="M9 12l2 2 4-4"></path></svg>
          </div>
          <div class="ncf-service-card__content">
            <h3 class="ncf-service-card__title">2-Year Nova Warranty</h3>
            <p class="ncf-service-card__description">Full hardware protection & priority component replacement service.</p>
          </div>
        </div>
        <div class="ncf-service-card ncf-service-card--{{ card_style }} ncf-service-card--align-{{ card_align }}">
          <div class="ncf-service-card__icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <div class="ncf-service-card__content">
            <h3 class="ncf-service-card__title">256-Bit Secure Checkout</h3>
            <p class="ncf-service-card__description">Bank-grade SSL encrypted transactions for complete peace of mind.</p>
          </div>
        </div>
        <div class="ncf-service-card ncf-service-card--{{ card_style }} ncf-service-card--align-{{ card_align }}">
          <div class="ncf-service-card__icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
          </div>
          <div class="ncf-service-card__content">
            <h3 class="ncf-service-card__title">30-Day Easy Returns</h3>
            <p class="ncf-service-card__description">No-questions-asked refund policy with automated prepaid shipping labels.</p>
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Trust & Service Features",
  "tag": "section",
  "class": "section-service-features",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE NOVA ADVANTAGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Title",
      "default": "Built for Absolute Confidence"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle Description",
      "default": "Premium service guarantees engineered to deliver an unrivaled shopping experience."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Center Aligned" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Grid & Layout Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Card Styling & Appearance"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card Visual Style",
      "options": [
        { "value": "minimal", "label": "Minimal (Transparent)" },
        { "value": "bordered", "label": "Bordered (Clean Light)" },
        { "value": "filled", "label": "Filled (Subtle Surface)" },
        { "value": "luxury", "label": "Luxury (Dark Gloss)" },
        { "value": "outlined", "label": "Outlined (Dashed Accent)" }
      ],
      "default": "bordered"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card Content Alignment",
      "options": [
        { "value": "left", "label": "Horizontal (Left Aligned)" },
        { "value": "center", "label": "Vertical (Center Aligned)" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Color Scheme & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0284c7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top Padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 56
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility Region Label",
      "default": "Store Guarantees & Service Features"
    }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Trust Feature Card",
      "settings": [
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icon Preset",
          "options": [
            { "value": "shipping", "label": "Fast Express Shipping" },
            { "value": "shield", "label": "Shield / Warranty" },
            { "value": "lock", "label": "Lock / Secure Payment" },
            { "value": "returns", "label": "Returns / Exchange" },
            { "value": "headphone", "label": "24/7 Customer Support" },
            { "value": "truck", "label": "Delivery Truck" },
            { "value": "award", "label": "Quality Award" },
            { "value": "sparkles", "label": "Sparkles / Special" }
          ],
          "default": "shipping"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code (Overrides Preset)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Tag (Optional)",
          "default": "POPULAR"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Free Global Shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Complimentary express delivery on all orders over $50 worldwide."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link URL (Optional)"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Text (Optional)",
          "default": "Learn More"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust & Service Features",
      "blocks": [
        {
          "type": "service_card",
          "settings": {
            "icon_preset": "shipping",
            "badge": "EXPRESS",
            "title": "Free Global Shipping",
            "description": "Complimentary express delivery on all orders over $50 worldwide."
          }
        },
        {
          "type": "service_card",
          "settings": {
            "icon_preset": "shield",
            "badge": "2-YEAR",
            "title": "Nova Full Warranty",
            "description": "Full hardware protection & priority component replacement service."
          }
        },
        {
          "type": "service_card",
          "settings": {
            "icon_preset": "lock",
            "badge": "SECURE",
            "title": "256-Bit SSL Checkout",
            "description": "Bank-grade encrypted transactions for complete peace of mind."
          }
        },
        {
          "type": "service_card",
          "settings": {
            "icon_preset": "returns",
            "badge": "EASY",
            "title": "30-Day Money Back",
            "description": "No-questions-asked refund policy with automated prepaid shipping labels."
          }
        }
      ]
    }
  ]
}
{% endschema %}
