{%- comment -%}
  Nova Commerce Framework (NCF) - Section: Main Product Detail Page (PDP)
  File: sections/main-product.liquid
  Sprint: 4.4 – Product Detail Page Foundation (Phase 1)
  Architecture: Production-Ready 50/50 Desktop Layout, Sticky Gallery, Natural Scrolling Buy Box,
  Mobile Stacked Layout, Sticky Mobile Add-to-Cart Bar, and Full Theme Editor Controls.
{%- endcomment -%}

{%- assign enable_sticky_gallery = section.settings.enable_sticky_gallery | default: true -%}
{%- assign enable_sticky_buybox = section.settings.enable_sticky_buybox | default: false -%}
{%- assign enable_sticky_mobile_atc = section.settings.enable_sticky_mobile_atc | default: true -%}
{%- assign enable_highlights = section.settings.enable_highlights | default: true -%}

<section
  class="ncf-main-product-section relative py-6 md:py-10 bg-white dark:bg-slate-950 transition-colors"
  data-section-id="{{ section.id }}"
  data-section-type="main-product"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {%- comment -%} Breadcrumb Navigation {%- endcomment -%}
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-6 font-medium" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Home</a>
      <span>/</span>
      <a href="{{ routes.all_products_collection_url }}" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Collections</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-slate-100 font-bold truncate max-w-[200px] sm:max-w-xs">
        {{ product.title | default: 'Nova Pro Wireless Headphones' }}
      </span>
    </nav>

    {%- comment -%} 50/50 Grid Container {%- endcomment -%}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      {%- comment -%} Left Column: Sticky Media Gallery (50% / 6 cols on lg) {%- endcomment -%}
      <div class="lg:col-span-6 {% if enable_sticky_gallery %}lg:sticky lg:top-24{% endif %} self-start">
        {% render 'product-media-gallery', product: product %}
      </div>

      {%- comment -%} Right Column: Buy Box & Product Spec Highlights (50% / 6 cols on lg) {%- endcomment -%}
      <div class="lg:col-span-6 space-y-8 {% if enable_sticky_buybox %}lg:sticky lg:top-24{% endif %}">
        {% render 'product-buy-box', product: product %}

        {%- if enable_highlights -%}
          {% render 'product-spec-highlights', product: product %}
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} Sprint 4.5: Feature Grid Section {%- endcomment -%}
    {%- if section.settings.enable_feature_grid -%}
      <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
        {% render 'product-feature-grid', product: product %}
      </div>
    {%- endif -%}

    {%- comment -%} Sprint 4.5: Information & Trust Tabs Section {%- endcomment -%}
    {%- if section.settings.enable_tabs -%}
      <div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800">
        {% render 'product-tabs', product: product %}
      </div>
    {%- endif -%}

    {%- comment -%} Sprint 4.6: Product Recommendation Engine Section {%- endcomment -%}
    <div class="mt-12">
      {% section 'product-recommendations' %}
    </div>

  </div>

  {%- comment -%} Product JSON-LD Structured Data for SEO {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | default: "Nova Pro Wireless Headphones" | json }},
      "image": [
        {{ product.featured_image | image_url: width: 1200 | json }}
      ],
      "description": {{ product.description | default: "Nova Pro Wireless Headphones with Active Noise Cancellation" | json }},
      "sku": {{ product.selected_or_first_available_variant.sku | default: "NCF-PRO-001" | json }},
      "brand": {
        "@type": "Brand",
        "name": "Nova Audio"
      },
      "offers": {
        "@type": "Offer",
        "url": {{ request.origin | append: product.url | json }},
        "priceCurrency": "USD",
        "price": "299.99",
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/InStock"
      }
    }
  </script>

  {%- comment -%} Sticky Mobile Add To Cart Floating Bar {%- endcomment -%}
  {%- if enable_sticky_mobile_atc -%}
    <div
      id="ncf-mobile-sticky-atc-bar"
      class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 dark:bg-slate-900/95 backdrop-blur-lg border-t border-slate-200 dark:border-slate-800 p-3 shadow-2xl transition-transform duration-300 translate-y-full"
      data-mobile-sticky-bar
    >
      <div class="flex items-center justify-between gap-3 max-w-md mx-auto">
        <div class="flex items-center gap-2.5 min-w-0">
          <img
            src="{{ product.featured_media | image_url: width: 120 | default: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=120&q=80' }}"
            alt="{{ product.title | escape }}"
            width="40"
            height="40"
            class="w-10 h-10 rounded-lg object-cover flex-shrink-0 border border-slate-200 dark:border-slate-800"
          />
          <div class="min-w-0">
            <span class="text-xs font-bold text-slate-900 dark:text-slate-100 truncate block leading-tight">
              {{ product.title | default: 'Nova Pro Headphones' }}
            </span>
            <span class="text-xs font-extrabold font-mono text-sky-600 dark:text-sky-400 block">
              {{ product.price | money | default: '₹14,999' }}
            </span>
          </div>
        </div>

        <button
          type="button"
          class="py-2.5 px-5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold shadow-md flex items-center gap-1.5 flex-shrink-0"
          data-pdp-sticky-atc-trigger
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <span>Add to Cart</span>
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Main Product Page",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "header",
      "content": "Layout Controls"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_gallery",
      "label": "Enable Sticky Media Gallery (Desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_buybox",
      "label": "Enable Sticky Buy Box (Desktop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_mobile_atc",
      "label": "Enable Sticky Mobile Add-To-Cart Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Media Gallery Features"
    },
    {
      "type": "checkbox",
      "id": "enable_gallery_zoom",
      "label": "Enable Gallery Image Zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_fullscreen_gallery",
      "label": "Enable Fullscreen Gallery Modal",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_videos",
      "label": "Enable Product Videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_3d_placeholder",
      "label": "Enable 3D Model Placeholder",
      "default": true
    },
    {
      "type": "header",
      "content": "Buy Box & Highlights Features"
    },
    {
      "type": "checkbox",
      "id": "enable_highlights",
      "label": "Enable Product Technical Highlights",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_trust_badges",
      "label": "Enable Trust Badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_dynamic_checkout",
      "label": "Enable Dynamic Checkout Buttons (Shop Pay)",
      "default": true
    },
    {
      "type": "header",
      "content": "Sprint 4.5: Product Information & Trust Tabs"
    },
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Enable Product Information Tabs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_specifications",
      "label": "Enable Specifications Table",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_feature_grid",
      "label": "Enable Technical Feature Grid",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_downloads",
      "label": "Enable Downloads Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_shipping",
      "label": "Enable Shipping Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_warranty",
      "label": "Enable Warranty Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_faq",
      "label": "Enable FAQ Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_payment_info",
      "label": "Enable Payment & EMI Info",
      "default": true
    }
  ]
}
{% endschema %}
