{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Trust & Service Feature Card
  File: snippets/service-feature-card.liquid
  Sprint: 2.3 - Trust & Service Features
{%- endcomment -%}

{%- assign icon_preset = block.settings.icon_preset | default: 'shipping' -%}
{%- assign card_title = block.settings.title | default: 'Feature Service Heading' -%}
{%- assign card_description = block.settings.description | default: 'Add your service highlight description here for shoppers.' -%}
{%- assign card_badge = block.settings.badge -%}
{%- assign card_link = block.settings.link -%}
{%- assign card_link_label = block.settings.link_label -%}

<div
  class="ncf-service-card ncf-service-card--{{ card_style | default: 'bordered' }} ncf-service-card--align-{{ card_align | default: 'left' }}"
  id="ncf-service-card-{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {%- comment -%} 1. ICON BOX GRAPHIC {%- endcomment -%}
  <div class="ncf-service-card__icon-box" aria-hidden="true">
    {%- if block.settings.custom_svg != blank -%}
      {{ block.settings.custom_svg }}
    {%- else -%}
      {%- case icon_preset -%}
        {%- when 'shipping' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="1" y="3" width="15" height="13" rx="2"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        {%- when 'shield' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="M9 12l2 2 4-4"></path>
          </svg>
        {%- when 'lock' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        {%- when 'returns' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
        {%- when 'headphone' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
          </svg>
        {%- when 'truck' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="2" y="5" width="13" height="11" rx="2"></rect>
            <line x1="2" y1="10" x2="15" y2="10"></line>
            <circle cx="6" cy="18" r="2"></circle>
            <circle cx="16" cy="18" r="2"></circle>
          </svg>
        {%- when 'award' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="8" r="7"></circle>
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
          </svg>
        {%- when 'sparkles' -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"></path>
          </svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
      {%- endcase -%}
    {%- endif -%}
  </div>

  {%- comment -%} 2. CARD CONTENT DETAILS {%- endcomment -%}
  <div class="ncf-service-card__content">
    {%- if card_badge != blank -%}
      <div class="ncf-service-card__badge-row">
        <span class="ncf-service-card__badge">{{ card_badge }}</span>
      </div>
    {%- endif -%}

    <h3 class="ncf-service-card__title">
      {%- if card_link != blank -%}
        <a href="{{ card_link }}" class="hover:underline color-inherit">
          {{ card_title }}
        </a>
      {%- else -%}
        {{ card_title }}
      {%- endif -%}
    </h3>

    {%- if card_description != blank -%}
      <p class="ncf-service-card__description">
        {{ card_description }}
      </p>
    {%- endif -%}

    {%- if card_link != blank and card_link_label != blank -%}
      <a href="{{ card_link }}" class="ncf-service-card__link">
        <span>{{ card_link_label }}</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    {%- endif -%}
  </div>
</div>
