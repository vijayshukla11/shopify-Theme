{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Mobile Navigation Drawer
  File: snippets/mobile-menu.liquid
  Sprint: 2.0 - Premium Announcement Bar & Enterprise Header
{%- endcomment -%}

<div class="ncf-mobile-drawer" data-mobile-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
  
  {%- comment -%} Dark Blur Backdrop Overlay {%- endcomment -%}
  <div class="ncf-mobile-drawer__overlay" data-mobile-drawer-overlay></div>

  <div class="ncf-mobile-drawer__content">
    
    {%- comment -%} Drawer Header {%- endcomment -%}
    <div class="ncf-mobile-drawer__header">
      <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 900; font-family: monospace; font-size: 1rem; letter-spacing: -0.02em;">
        <span style="width: 1.75rem; height: 1.75rem; background: #0284c7; color: #fff; border-radius: 0.25rem; display: inline-flex; align-items: center; justify-content: center;">N</span>
        <span>NOVA TECH</span>
      </div>

      <button type="button" class="ncf-announcement-bar__btn" data-mobile-drawer-close aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    {%- comment -%} Drawer Body Navigation {%- endcomment -%}
    <div class="ncf-mobile-drawer__body">
      
      {%- comment -%} Mobile Search Bar {%- endcomment -%}
      <div style="margin-bottom: 1.25rem;">
        {% render 'header-search' %}
      </div>

      {%- comment -%} Mobile Navigation Links List {%- endcomment -%}
      <nav aria-label="Mobile Menu">
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.25rem;">
          
          {%- assign menu_handle = section.settings.main_menu | default: 'main-menu' -%}
          {%- if linklists[menu_handle].links.size > 0 -%}
            {%- for link in linklists[menu_handle].links -%}
              <li style="border-bottom: 1px solid #f1f5f9; padding-bottom: 0.5rem;">
                <a
                  href="{{ link.url }}"
                  style="display: flex; align-items: center; justify-content: space-between; font-weight: 700; font-size: 0.875rem; color: #0f172a; text-decoration: none; padding: 0.5rem 0; text-transform: uppercase; letter-spacing: 0.02em;"
                >
                  <span>{{ link.title }}</span>
                  {%- if link.links.size > 0 -%}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  {%- endif -%}
                </a>

                {%- if link.links.size > 0 -%}
                  <ul style="list-style: none; padding-left: 1rem; margin: 0.25rem 0; display: flex; flex-direction: column; gap: 0.375rem;">
                    {%- for child_link in link.links -%}
                      <li>
                        <a href="{{ child_link.url }}" style="font-size: 0.8125rem; font-weight: 500; color: #475569; text-decoration: none;">
                          {{ child_link.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Fallback Demo Navigation Links {%- endcomment -%}
            <li style="border-bottom: 1px solid #f1f5f9; padding: 0.5rem 0;">
              <a href="{{ routes.collections_url }}/shirts" style="font-weight: 700; font-size: 0.875rem; color: #0f172a; text-decoration: none; text-transform: uppercase;">Shirts</a>
            </li>
            <li style="border-bottom: 1px solid #f1f5f9; padding: 0.5rem 0;">
              <a href="{{ routes.collections_url }}/trousers" style="font-weight: 700; font-size: 0.875rem; color: #0f172a; text-decoration: none; text-transform: uppercase;">Trousers</a>
            </li>
            <li style="border-bottom: 1px solid #f1f5f9; padding: 0.5rem 0;">
              <a href="{{ routes.collections_url }}/jeans" style="font-weight: 700; font-size: 0.875rem; color: #0f172a; text-decoration: none; text-transform: uppercase;">Jeans</a>
            </li>
            <li style="border-bottom: 1px solid #f1f5f9; padding: 0.5rem 0;">
              <a href="{{ routes.collections_url }}/cargos" style="font-weight: 700; font-size: 0.875rem; color: #0f172a; text-decoration: none; text-transform: uppercase;">Cargos</a>
            </li>
          {%- endif -%}

        </ul>
      </nav>

      {%- comment -%} Support & Account Actions Footer in Mobile Menu {%- endcomment -%}
      <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px dashed #cbd5e1; font-size: 0.75rem; color: #64748b; font-family: monospace;">
        <div style="margin-bottom: 0.5rem; font-weight: 700; color: #0f172a;">ATELIER CONCIERGE</div>
        <div>Customer Care: +91 800-CLINZA</div>
        <div>Mon-Sat: 10am - 8pm IST</div>
      </div>

    </div>
  </div>
</div>
