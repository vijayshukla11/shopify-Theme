{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Product Feature Grid
  File: snippets/product-feature-grid.liquid
  Sprint: 4.5 – Product Information, Specifications & Trust Experience
{%- endcomment -%}

<div class="ncf-pdp-feature-grid w-full my-8" data-product-feature-grid>
  <div class="mb-6 text-center max-w-xl mx-auto">
    <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
      Architected for Unrivaled Performance
    </h2>
    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
      Key technology features engineered into every unit.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {%- comment -%} Card 1: Active Noise Cancellation {%- endcomment -%}
    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800/80 space-y-2 hover:border-sky-500/50 transition-all hover:-translate-y-0.5">
      <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 10v4"></path><path d="M6 6v12"></path><path d="M10 3v18"></path><path d="M14 8v8"></path><path d="M18 5v14"></path><path d="M22 10v4"></path></svg>
      </div>
      <h3 class="text-sm font-extrabold text-slate-900 dark:text-slate-100">Adaptive ANC Pro</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Real-time acoustic noise cancellation adapting to environment 48,000 times per second.</p>
    </div>

    {%- comment -%} Card 2: High-Res Audio Driver {%- endcomment -%}
    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800/80 space-y-2 hover:border-sky-500/50 transition-all hover:-translate-y-0.5">
      <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path></svg>
      </div>
      <h3 class="text-sm font-extrabold text-slate-900 dark:text-slate-100">Titanium Acoustics</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">40mm custom titanium diaphragms deliver deep sub-bass and ultra-crisp highs.</p>
    </div>

    {%- comment -%} Card 3: Extended Battery Life {%- endcomment -%}
    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800/80 space-y-2 hover:border-sky-500/50 transition-all hover:-translate-y-0.5">
      <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="16" height="10" rx="2" ry="2"></rect><line x1="22" y1="11" x2="22" y2="13"></line></svg>
      </div>
      <h3 class="text-sm font-extrabold text-slate-900 dark:text-slate-100">40-Hour Playback</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Fast-charge technology gives 5 hours of listening time from a quick 10-minute charge.</p>
    </div>

    {%- comment -%} Card 4: Ultra Wireless Connectivity {%- endcomment -%}
    <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800/80 space-y-2 hover:border-sky-500/50 transition-all hover:-translate-y-0.5">
      <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
      </div>
      <h3 class="text-sm font-extrabold text-slate-900 dark:text-slate-100">Bluetooth 5.3 + UWB</h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">Multi-device multipoint pairing with lossless audio streaming codecs LDAC & aptX.</p>
    </div>
  </div>
</div>
