{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: PLP Accordion Filter Group
  File: snippets/plp-filter-group.liquid
  Sprint: 4.1 – Premium Collection Filters & Product Listing Experience
  Architecture: Reusable Accordion Group supporting Swatches, Pills, Search & Price Sliders
{%- endcomment -%}

{%- assign group_label_downcase = filter.label | downcase -%}
{%- assign show_search = show_search | default: true -%}
{%- assign show_product_count = show_product_count | default: true -%}
{%- assign is_expanded = true -%}
{%- if group_index >= default_expanded_count -%}
  {%- assign is_expanded = false -%}
{%- endif -%}

<div class="ncf-filter-group border-b border-slate-200 dark:border-slate-800 py-4" data-filter-group-type="{{ filter.type }}" data-filter-label="{{ filter.label | escape }}">
  
  {%- comment -%} ACCORDION HEADER {%- endcomment -%}
  <button
    type="button"
    class="w-full flex items-center justify-between text-left font-extrabold text-sm text-slate-900 dark:text-slate-100 hover:text-sky-600 dark:hover:text-sky-400 py-1 focus:outline-none focus:ring-2 focus:ring-sky-500 rounded group min-h-[40px]"
    aria-expanded="{% if is_expanded %}true{% else %}false{% endif %}"
    aria-controls="ncf-filter-body-{{ group_index }}"
    data-accordion-trigger
  >
    <div class="flex items-center gap-2">
      <span>{{ filter.label }}</span>
      {%- assign active_values_count = filter.active_values.size -%}
      {%- if active_values_count > 0 -%}
        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-sky-500 text-white text-[10px] font-extrabold">
          {{ active_values_count }}
        </span>
      {%- endif -%}
    </div>
    <svg class="w-4 h-4 text-slate-400 group-hover:text-sky-600 transition-transform duration-200 {% if is_expanded %}rotate-180{% endif %}" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-accordion-chevron>
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  {%- comment -%} ACCORDION BODY {%- endcomment -%}
  <div
    id="ncf-filter-body-{{ group_index }}"
    class="pt-3 pb-1 space-y-3 {% if is_expanded == false %}hidden{% endif %}"
    data-accordion-body
  >
    
    {%- comment -%} CASE 1: PRICE RANGE FILTER {%- endcomment -%}
    {%- if filter.type == 'price_range' -%}
      <div class="ncf-filter-price-range space-y-3">
        {%- assign max_price = filter.range_max | divided_by: 100.0 | ceil -%}
        {%- assign min_val = filter.min_value.value | divided_by: 100.0 | default: 0 -%}
        {%- assign max_val = filter.max_value.value | divided_by: 100.0 | default: max_price -%}

        {/* Visual Dual-Thumb Slider */}
        <div class="relative py-2 px-1">
          <div class="h-1.5 bg-slate-200 dark:bg-slate-700 rounded-full relative">
            <div
              class="absolute h-full bg-sky-500 rounded-full"
              style="left: {{ min_val | times: 100.0 | divided_by: max_price }}%; right: {{ 100.0 | minus: max_val | times: 100.0 | divided_by: max_price }}%;"
              data-price-range-track
            ></div>
          </div>
          <input
            type="range"
            min="0"
            max="{{ max_price }}"
            value="{{ min_val }}"
            class="absolute top-0 left-0 w-full h-5 opacity-0 cursor-pointer pointer-events-none"
            data-price-range-min-slider
          />
          <input
            type="range"
            min="0"
            max="{{ max_price }}"
            value="{{ max_val }}"
            class="absolute top-0 left-0 w-full h-5 opacity-0 cursor-pointer pointer-events-none"
            data-price-range-max-slider
          />
        </div>

        <div class="grid grid-cols-2 gap-3 pt-1">
          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">$</span>
            <input
              type="number"
              name="{{ filter.min_value.param_name }}"
              id="Filter-{{ filter.param_name }}-min"
              value="{{ min_val }}"
              placeholder="0"
              min="0"
              max="{{ max_price }}"
              class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-lg pl-7 pr-3 py-2 text-xs font-mono font-semibold text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500 min-h-[44px]"
              data-price-min-input
            />
            <label for="Filter-{{ filter.param_name }}-min" class="sr-only">{{ 'products.facets.price_min' | t | default: 'Minimum Price' }}</label>
          </div>

          <div class="relative">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">$</span>
            <input
              type="number"
              name="{{ filter.max_value.param_name }}"
              id="Filter-{{ filter.param_name }}-max"
              value="{{ max_val }}"
              placeholder="{{ max_price }}"
              min="0"
              max="{{ max_price }}"
              class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-lg pl-7 pr-3 py-2 text-xs font-mono font-semibold text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500 min-h-[44px]"
              data-price-max-input
            />
            <label for="Filter-{{ filter.param_name }}-max" class="sr-only">{{ 'products.facets.price_max' | t | default: 'Maximum Price' }}</label>
          </div>
        </div>
      </div>

    {%- comment -%} CASE 2: COLOR SWATCHES {%- endcomment -%}
    {%- elsif group_label_downcase contains 'color' or group_label_downcase contains 'colour' -%}
      <ul class="flex flex-wrap gap-2 pt-1" data-filter-options-list>
        {%- for value in filter.values -%}
          {%- assign color_hex = '#000000' -%}
          {%- assign val_lc = value.label | downcase -%}
          {%- if val_lc contains 'white' -%}{%- assign color_hex = '#ffffff' -%}
          {%- elsif val_lc contains 'black' -%}{%- assign color_hex = '#0f172a' -%}
          {%- elsif val_lc contains 'silver' or val_lc contains 'gray' or val_lc contains 'grey' -%}{%- assign color_hex = '#94a3b8' -%}
          {%- elsif val_lc contains 'blue' -%}{%- assign color_hex = '#0284c7' -%}
          {%- elsif val_lc contains 'red' -%}{%- assign color_hex = '#ef4444' -%}
          {%- elsif val_lc contains 'green' -%}{%- assign color_hex = '#10b981' -%}
          {%- elsif val_lc contains 'gold' or val_lc contains 'yellow' -%}{%- assign color_hex = '#eab308' -%}
          {%- elsif val_lc contains 'purple' -%}{%- assign color_hex = '#a855f7' -%}
          {%- endif -%}

          <li>
            <label
              class="relative flex items-center justify-center w-8 h-8 rounded-full border-2 cursor-pointer transition-all hover:scale-110 focus-within:ring-2 focus-within:ring-sky-500 {% if value.active %}border-sky-500 shadow-sm ring-2 ring-sky-500/30{% else %}border-slate-300 dark:border-slate-700{% endif %}"
              style="background-color: {{ color_hex }};"
              title="{{ value.label }} ({{ value.count }})"
            >
              <input
                type="checkbox"
                name="{{ value.param_name }}"
                value="{{ value.value }}"
                class="sr-only"
                {% if value.active %}checked{% endif %}
                {% if value.count == 0 and value.active == false %}disabled{% endif %}
              >
              {%- if value.active -%}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="{% if color_hex == '#ffffff' %}#0f172a{% else %}#ffffff{% endif %}" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              {%- endif -%}
            </label>
          </li>
        {%- endfor -%}
      </ul>

    {%- comment -%} CASE 3: SIZE / CAPACITY / STORAGE / RAM PILLS {%- endcomment -%}
    {%- elsif group_label_downcase contains 'size' or group_label_downcase contains 'capacity' or group_label_downcase contains 'storage' or group_label_downcase contains 'ram' -%}
      <ul class="flex flex-wrap gap-2 pt-1" data-filter-options-list>
        {%- for value in filter.values -%}
          <li>
            <label
              class="inline-flex items-center justify-center px-3 py-2 rounded-xl text-xs font-mono font-bold border transition-all cursor-pointer min-h-[44px] min-w-[44px] focus-within:ring-2 focus-within:ring-sky-500 {% if value.active %}bg-sky-500 text-white border-sky-600 shadow-xs{% else %}bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-200 border-slate-300 dark:border-slate-700 hover:border-sky-400{% endif %}"
            >
              <input
                type="checkbox"
                name="{{ value.param_name }}"
                value="{{ value.value }}"
                class="sr-only"
                {% if value.active %}checked{% endif %}
                {% if value.count == 0 and value.active == false %}disabled{% endif %}
              >
              <span>{{ value.label }}</span>
            </label>
          </li>
        {%- endfor -%}
      </ul>

    {%- comment -%} CASE 4: STANDARD CHECKBOX LIST (VENDOR, BRAND, AVAILABILITY, MATERIAL, SYSTEM) {%- endcomment -%}
    {%- else -%}
      
      {%- comment -%} In-Facet List Search if list is long {%- endcomment -%}
      {%- if filter.values.size > 6 and show_search -%}
        <div class="relative mb-2">
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            placeholder="{{ 'products.facets.search_options' | t | default: 'Search options...' }}"
            class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-lg pl-8 pr-3 py-1.5 text-xs text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500 min-h-[38px]"
            data-in-facet-search
          >
        </div>
      {%- endif -%}

      <ul class="space-y-2 max-h-60 overflow-y-auto pr-1" data-filter-options-list>
        {%- for value in filter.values -%}
          <li class="ncf-filter-option-item flex items-center justify-between group" data-option-label="{{ value.label | downcase }}">
            <label class="inline-flex items-center gap-2.5 text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 cursor-pointer min-h-[44px] w-full">
              <input
                type="checkbox"
                name="{{ value.param_name }}"
                value="{{ value.value }}"
                class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 text-sky-600 focus:ring-sky-500 cursor-pointer"
                {% if value.active %}checked{% endif %}
                {% if value.count == 0 and value.active == false %}disabled{% endif %}
              >
              <span class="leading-tight">{{ value.label }}</span>
            </label>
            {%- if show_product_count -%}
              <span class="text-[11px] font-mono text-slate-400 font-medium ml-2">({{ value.count }})</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%} Show More / Less Toggle for Long Lists {%- endcomment -%}
      {%- if filter.values.size > 8 -%}
        <button
          type="button"
          class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline pt-2 focus:outline-none min-h-[36px]"
          data-show-more-toggle
        >
          {{ 'products.facets.show_more' | t | default: '+ Show More' }}
        </button>
      {%- endif -%}

    {%- endif -%}

  </div>
</div>
