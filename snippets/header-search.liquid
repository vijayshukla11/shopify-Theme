{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Header Search
  File: snippets/header-search.liquid
  Sprint: 2.0 - Premium Announcement Bar & Enterprise Header
{%- endcomment -%}

<div class="ncf-header-search" data-header-search>
  <form action="{{ routes.search_url }}" method="get" role="search" class="ncf-header-search__form">
    
    {%- comment -%} Search Icon {%- endcomment -%}
    <span class="ncf-header-search__icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </span>

    {%- comment -%} Search Input {%- endcomment -%}
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ section.settings.search_placeholder | default: 'Search 10,000+ premium electronics, gadgets & gear...' | escape }}"
      class="ncf-header-search__input"
      aria-label="{{ 'general.search.search' | t | default: 'Search Store' }}"
      autocomplete="off"
      autocorrect="off"
      capitalize="off"
      spellcheck="false"
    >

    {%- comment -%} Optional Category Filter Select {%- endcomment -%}
    {%- if section.settings.show_search_categories -%}
      <select name="type" class="ncf-header-search__category" aria-label="Search Filter">
        <option value="product">All Categories</option>
        <option value="product_audio">Audio & Headphones</option>
        <option value="product_computing">Laptops & Monitors</option>
        <option value="product_wearables">Smart Wearables</option>
        <option value="product_accessories">Gear & Accessories</option>
      </select>
    {%- endif -%}

    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">

    {%- comment -%} Submit Button {%- endcomment -%}
    <button type="submit" class="ncf-header-search__submit" aria-label="{{ 'general.search.submit' | t | default: 'Search' }}">
      Search
    </button>
  </form>

  {%- comment -%} Predictive Search Results & Popular Search Tags Dropdown {%- endcomment -%}
  <div class="ncf-header-search__results" data-search-results role="listbox" aria-label="Search suggestions">
    <div class="ncf-header-search__popular">
      <span style="font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: #64748b; letter-spacing: 0.05em; display: block; margin-bottom: 0.375rem;">
        Popular Trending Searches
      </span>
      <div class="ncf-header-search__tags">
        <a href="{{ routes.search_url }}?q=Noise+Cancelling" class="ncf-header-search__tag">ANC Headphones</a>
        <a href="{{ routes.search_url }}?q=OLED+Monitor" class="ncf-header-search__tag">4K OLED Displays</a>
        <a href="{{ routes.search_url }}?q=M3+Max+Laptop" class="ncf-header-search__tag">OLED Laptops</a>
        <a href="{{ routes.search_url }}?q=Titanium+Smartwatch" class="ncf-header-search__tag">Titanium Watches</a>
        <a href="{{ routes.search_url }}?q=RGB+Keyboard" class="ncf-header-search__tag">Mechanical Keyboards</a>
      </div>
    </div>
  </div>
</div>
