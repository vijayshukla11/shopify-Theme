{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Footer Navigation Column
  File: snippets/footer-column.liquid
  Sprint: 3.0 – Enterprise Footer System
  Architecture: Collapsible Accessible Navigation Column
{%- endcomment -%}

<div
  class="ncf-footer-col"
  data-collapsible
  aria-expanded="false"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="ncf-footer-col__title-btn"
    aria-expanded="false"
    aria-controls="footer-col-{{ block.id }}"
  >
    <span>{{ block.settings.title | default: 'Column Title' }}</span>
    <svg class="ncf-footer-col__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="ncf-footer-col__content" id="footer-col-{{ block.id }}">
    {%- case block.type -%}
      {%- when 'link_list' -%}
        {%- assign menu = block.settings.menu -%}
        {%- if menu != blank and linklists[menu].links.size > 0 -%}
          <ul class="ncf-footer-col__list">
            {%- for link in linklists[menu].links -%}
              <li>
                <a href="{{ link.url }}" class="ncf-footer-col__link">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <ul class="ncf-footer-col__list">
            <li><a href="#" class="ncf-footer-col__link">Overview</a></li>
            <li><a href="#" class="ncf-footer-col__link">New Arrivals</a></li>
            <li><a href="#" class="ncf-footer-col__link">Best Sellers</a></li>
            <li><a href="#" class="ncf-footer-col__link">Special Edition</a></li>
          </ul>
        {%- endif -%}

      {%- when 'contact' -%}
        <div class="ncf-footer-contact">
          {%- if block.settings.phone != blank -%}
            <div class="ncf-footer-contact__item">
              <svg class="ncf-footer-contact__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{{ block.settings.phone }}</span>
            </div>
          {%- endif -%}

          {%- if block.settings.email != blank -%}
            <div class="ncf-footer-contact__item">
              <svg class="ncf-footer-contact__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>{{ block.settings.email }}</span>
            </div>
          {%- endif -%}

          {%- if block.settings.address != blank -%}
            <div class="ncf-footer-contact__item">
              <svg class="ncf-footer-contact__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{{ block.settings.address }}</span>
            </div>
          {%- endif -%}

          {%- if block.settings.hours != blank -%}
            <div class="ncf-footer-contact__item">
              <svg class="ncf-footer-contact__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>{{ block.settings.hours }}</span>
            </div>
          {%- endif -%}
        </div>

      {%- when 'text' -%}
        <div class="text-sm space-y-2">
          {{ block.settings.content }}
        </div>
    {%- endcase -%}
  </div>
</div>
