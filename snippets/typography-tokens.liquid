{%- comment -%}
  Nova Commerce Framework (NCF)
  File: snippets/typography-tokens.liquid
  Description: Injects dynamic CSS variables for colors, typography scales, layout widths, and grid gaps into <head>.
{%- endcomment -%}

<style id="ncf-theme-tokens">
  :root {
    /* CLINZA Design System Color Tokens */
    --color-background: {{ settings.color_primary_bg | default: '#ffffff' }};
    --color-surface: {{ settings.color_secondary_bg | default: '#f8fafc' }};
    --color-text: {{ settings.color_primary_text | default: '#111827' }};
    --color-muted: {{ settings.color_muted_text | default: '#6b7280' }};
    --color-border: {{ settings.color_border | default: '#e5e7eb' }};
    --color-primary: {{ settings.color_primary_text | default: '#111827' }};
    --color-accent: {{ settings.color_brand_accent | default: '#2563eb' }};
    --color-accent-hover: #1d4ed8;
    --color-success: {{ settings.color_success | default: '#16a34a' }};
    --color-warning: {{ settings.color_warning | default: '#f59e0b' }};
    --color-danger: {{ settings.color_danger | default: '#dc2626' }};

    /* Backwards-compatible aliases */
    --color-primary-bg: var(--color-background);
    --color-secondary-bg: var(--color-surface);
    --color-primary-text: var(--color-text);
    --color-muted-text: var(--color-muted);
    --color-brand-accent: var(--color-accent);

    /* Spacing Scale Tokens */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;
    --space-12: 48px;
    --space-16: 64px;

    /* Typography Font Families */
    --font-heading-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-body-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-code-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    /* Responsive Typography Scales */
    --font-h1: clamp(2rem, 4vw + 1rem, 3.25rem); /* Mobile 32px -> Desktop 52px */
    --font-h2: clamp(1.5rem, 2.5vw + 0.875rem, 2.25rem); /* Mobile 24px -> Desktop 36px */
    --font-h3: clamp(1.125rem, 1.5vw + 0.75rem, 1.375rem); /* Mobile 18px -> Desktop 22px */
    --font-body: clamp(0.875rem, 0.5vw + 0.75rem, 1rem); /* Mobile 14px -> Desktop 16px */
    --font-small: 0.8125rem; /* 13px */
    --font-xs: 0.75rem; /* 12px */

    /* Section Spacing Rhythms */
    --section-spacing-desktop: 56px;
    --section-spacing-mobile: 36px;

    /* Layout & Container System */
    --page-width-max: {{ settings.layout_page_width | default: 1440 }}px;
    --container-padding-desktop: 32px;
    --container-padding-mobile: 16px;

    /* Component Border Radius Tokens */
    --button-radius: {{ settings.button_border_radius | default: 6 }}px;
    --input-radius: {{ settings.input_border_radius | default: 6 }}px;
    --card-radius: {{ settings.card_border_radius | default: 8 }}px;
    --badge-radius: {{ settings.badge_border_radius | default: 4 }}px;

    /* Z-Index Hierarchy Layering */
    --z-index-base: 1;
    --z-index-dropdown: 100;
    --z-index-sticky: 500;
    --z-index-header: 800;
    --z-index-overlay: 900;
    --z-index-drawer: 1000;
    --z-index-modal: 1100;
    --z-index-toast: 1200;
    --z-index-skip-link: 9999;
  }
</style>
