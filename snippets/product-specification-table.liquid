{%- comment -%}
  CLINZA Commerce - Snippet: Product Specification Table
  File: snippets/product-specification-table.liquid
  Dynamic Metafield Engine: only renders attributes with genuine metafield values.
{%- endcomment -%}

{%- assign specs_processor = product.metafields.specs.processor.value | default: product.metafields.custom.processor.value -%}
{%- assign specs_ram = product.metafields.specs.ram.value | default: product.metafields.custom.ram.value -%}
{%- assign specs_storage = product.metafields.specs.storage.value | default: product.metafields.custom.storage.value -%}
{%- assign specs_display = product.metafields.specs.display.value | default: product.metafields.custom.display.value -%}
{%- assign specs_battery = product.metafields.specs.battery.value | default: product.metafields.custom.battery.value -%}
{%- assign specs_connectivity = product.metafields.specs.connectivity.value | default: product.metafields.custom.connectivity.value -%}
{%- assign specs_weight = product.metafields.specs.weight.value | default: product.metafields.custom.weight.value -%}
{%- assign specs_warranty = product.metafields.specs.warranty.value | default: product.metafields.custom.warranty.value -%}
{%- assign specs_compatibility = product.metafields.specs.compatibility.value | default: product.metafields.custom.compatibility.value -%}
{%- assign specs_water_resistance = product.metafields.specs.water_resistance.value | default: product.metafields.custom.water_resistance.value -%}

{%- assign has_any_spec = false -%}
{%- if specs_processor != blank or specs_ram != blank or specs_storage != blank or specs_display != blank or specs_battery != blank or specs_connectivity != blank or specs_weight != blank or specs_warranty != blank or specs_compatibility != blank or specs_water_resistance != blank -%}
  {%- assign has_any_spec = true -%}
{%- endif -%}

{%- if has_any_spec -%}
<div class="ncf-pdp-spec-table-wrapper w-full overflow-hidden rounded-xl border border-[#E5E7E5] bg-[#FFFFFF]">
  <table class="w-full text-left text-xs border-collapse">
    <thead class="bg-[#F7F8F6] border-b border-[#E5E7E5] text-[#111827] uppercase font-mono font-bold tracking-wider">
      <tr>
        <th scope="col" class="py-3 px-4 sm:px-6 w-1/3">Specification</th>
        <th scope="col" class="py-3 px-4 sm:px-6 w-2/3">Details</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[#E5E7E5] text-[#111827]">
      {%- if specs_display != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Display</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_display }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_battery != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Battery & Charging</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_battery }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_connectivity != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Connectivity</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_connectivity }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_compatibility != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Compatibility</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_compatibility }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_water_resistance != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Water Resistance</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_water_resistance }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_processor != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Processor / Chipset</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_processor }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_ram != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Memory Buffer</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_ram }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_storage != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Storage Capacity</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_storage }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_weight != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Weight & Build</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_weight }}</td>
        </tr>
      {%- endif -%}

      {%- if specs_warranty != blank -%}
        <tr class="hover:bg-[#F7F8F6] transition-colors">
          <td class="py-3 px-4 sm:px-6 font-medium text-[#667085]">Warranty</td>
          <td class="py-3 px-4 sm:px-6 font-semibold">{{ specs_warranty }}</td>
        </tr>
      {%- endif -%}
    </tbody>
  </table>
</div>
{%- endif -%}
