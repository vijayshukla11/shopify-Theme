{%- comment -%}
  Snippet: Page Header
  Sprint: 2.0 - Reusable Internal Page Header Component
  
  Parameters:
  - title: Page H1 title (required)
  - description: Short optional description text (optional)
  - badge: Optional tag/badge text (optional)
  - cta_label: Text for optional CTA button (optional)
  - cta_url: URL for optional CTA button (optional)
  - parent_title: Parent breadcrumb label (optional)
  - parent_url: Parent breadcrumb link (optional)
{%- endcomment -%}

<div class="page-header-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-6">
  <div class="page-header-card bg-slate-900 text-white border border-slate-800 rounded-2xl p-5 sm:p-6 shadow-md relative overflow-hidden">
    <div class="absolute -right-10 -top-10 w-48 h-48 bg-sky-500/10 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1.5 max-w-3xl">
        
        {%- comment -%} Breadcrumbs {%- endcomment -%}
        <nav class="page-header-breadcrumbs flex items-center flex-wrap gap-1.5 text-xs text-slate-400 font-mono" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}" class="hover:text-white transition-colors">Home</a>
          <span class="text-slate-600">/</span>
          {%- if parent_title != blank -%}
            {%- if parent_url != blank -%}
              <a href="{{ parent_url }}" class="hover:text-white transition-colors">{{ parent_title }}</a>
            {%- else -%}
              <span>{{ parent_title }}</span>
            {%- endif -%}
            <span class="text-slate-600">/</span>
          {%- endif -%}
          <span class="text-sky-400 font-bold truncate max-w-[200px] sm:max-w-xs" aria-current="page">
            {{ title | default: page_title }}
          </span>
        </nav>

        {%- if badge != blank -%}
          <div class="pt-0.5">
            <span class="px-2.5 py-0.5 rounded-full bg-sky-500/20 text-sky-300 text-[10px] font-mono font-bold uppercase tracking-wider border border-sky-500/30">
              {{ badge }}
            </span>
          </div>
        {%- endif -%}

        {%- comment -%} Page Title H1 {%- endcomment -%}
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white uppercase leading-tight">
          {{ title | default: page_title }}
        </h1>

        {%- comment -%} Optional Short Description {%- endcomment -%}
        {%- if description != blank -%}
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-2xl">
            {{ description }}
          </p>
        {%- endif -%}
      </div>

      {%- comment -%} Optional CTA Button {%- endcomment -%}
      {%- if cta_label != blank and cta_url != blank -%}
        <div class="shrink-0 pt-2 md:pt-0">
          <a href="{{ cta_url }}" class="px-4 py-2 rounded-lg font-bold text-xs sm:text-sm bg-sky-500 text-slate-950 hover:bg-sky-400 inline-flex items-center justify-center gap-2 transition-all shadow-sm">
            <span>{{ cta_label }}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
