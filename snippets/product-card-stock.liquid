{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Product Card Stock Status Indicator
  File: snippets/product-card-stock.liquid
  Sprint: 4.3 – Premium Product Cards & Shopping Experience
{%- endcomment -%}

{%- assign show_stock = show_stock | default: true -%}
{%- assign low_stock_threshold = 5 -%}

{%- if show_stock -%}
  <div class="ncf-stock-badge-wrapper my-1.5" data-stock-wrapper>
    {%- if product.available == false -%}
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-rose-50 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300 text-[11px] font-medium border border-rose-200/80 dark:border-rose-800/80">
        <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
        <span>{{ 'products.product.sold_out' | t | default: 'Out of Stock' }}</span>
      </span>
    {%- elsif product.selected_or_first_available_variant.inventory_quantity > 0 and product.selected_or_first_available_variant.inventory_quantity <= low_stock_threshold -%}
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 text-[11px] font-medium border border-amber-200/80 dark:border-amber-800/80">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-ping"></span>
        <span>Only {{ product.selected_or_first_available_variant.inventory_quantity }} left</span>
      </span>
    {%- elsif product.template_suffix == 'preorder' or product.tags contains 'preorder' -%}
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 text-[11px] font-medium border border-purple-200/80 dark:border-purple-800/80">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
        <span>Pre-order Now</span>
      </span>
    {%- else -%}
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 text-[11px] font-medium border border-emerald-200/80 dark:border-emerald-800/80">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>In Stock</span>
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
