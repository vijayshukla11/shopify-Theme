{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Product Price
  File: snippets/product-price.liquid
  Sprint: 2.4 - Enterprise Product Card System
{%- endcomment -%}

{%- assign target = product.selected_or_first_available_variant | default: product -%}
{%- assign price = target.price | default: 19900 -%}
{%- assign compare_at_price = target.compare_at_price -%}
{%- assign available = target.available | default: true -%}
{%- assign price_varies = product.price_varies -%}
{%- assign money_price = price | money -%}

{%- if settings.currency_code_enabled -%}
  {%- assign money_price = price | money_with_currency -%}
{%- endif -%}

<div class="ncf-price {% if compare_at_price > price %}ncf-price--on-sale{% endif %} {% if available == false %}ncf-price--sold-out{% endif %}">
  <div class="ncf-price__container">
    
    {%- comment -%} Price Varies Prefix (e.g. "From $19.99") {%- endcomment -%}
    {%- if price_varies -%}
      <span class="ncf-price__from">
        {{ 'products.product.from_price_html' | t: price: money_price | default: 'From ' }}
      </span>
    {%- endif -%}

    {%- comment -%} Regular Active Price {%- endcomment -%}
    <span class="ncf-price__regular">
      <span class="sr-only">{{ 'products.product.price.regular_price' | t | default: 'Regular price' }}</span>
      <span class="ncf-price-item ncf-price-item--regular">
        {{ money_price }}
      </span>
    </span>

    {%- comment -%} Compare At Original Price (Strikethrough) {%- endcomment -%}
    {%- if compare_at_price > price -%}
      <span class="ncf-price__compare">
        <span class="sr-only">{{ 'products.product.price.sale_price' | t | default: 'Sale price' }}</span>
        <span class="ncf-price-item ncf-price-item--sale">
          {%- if settings.currency_code_enabled -%}
            {{ compare_at_price | money_with_currency }}
          {%- else -%}
            {{ compare_at_price | money }}
          {%- endif -%}
        </span>
      </span>

      {%- if show_savings -%}
        {%- assign saved_amount = compare_at_price | minus: price -%}
        {%- assign saved_percent = saved_amount | times: 100.0 | divided_by: compare_at_price | round -%}
        <span class="ncf-price__save-badge">
          Save {{ saved_percent }}%
        </span>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Unit Price (e.g. per 100ml) {%- endcomment -%}
    {%- if target.unit_price_measurement -%}
      <div class="ncf-price__unit">
        <span class="sr-only">{{ 'products.product.price.unit_price' | t | default: 'Unit price' }}</span>
        <span>{{ target.unit_price | money }}</span>
        <span aria-hidden="true">/</span>
        <span class="sr-only">&nbsp;per&nbsp;</span>
        <span>
          {%- if target.unit_price_measurement.reference_value != 1 -%}
            {{ target.unit_price_measurement.reference_value }}
          {%- endif -%}
          {{ target.unit_price_measurement.reference_unit }}
        </span>
      </div>
    {%- endif -%}

  </div>
</div>
