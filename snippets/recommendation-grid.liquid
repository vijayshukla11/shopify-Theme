{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Recommendation Grid
  File: snippets/recommendation-grid.liquid
  Sprint: 4.6 – Product Recommendation System
{%- endcomment -%}

{%- assign desktop_columns = desktop_columns | default: 4 -%}
{%- assign mobile_columns = mobile_columns | default: 2 -%}
{%- assign limit = limit | default: 8 -%}
{%- assign rec_type = rec_type | default: "related" -%}

<div class="ncf-rec-grid ncf-rec-grid-cols-{{ mobile_columns }} ncf-rec-grid-sm-2 ncf-rec-grid-lg-{{ desktop_columns }}">
  {%- for i in (1..limit) -%}
    <div class="ncf-rec-grid-item">
      {% render 'recommendation-card', 
        product: recommendations.products[forloop.index0], 
        index: i,
        rec_type: rec_type,
        is_bundle: is_bundle
      %}
    </div>
  {%- endfor -%}
</div>
