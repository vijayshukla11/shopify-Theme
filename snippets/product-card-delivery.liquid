{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Product Card Delivery & Trust Badges
  File: snippets/product-card-delivery.liquid
  Sprint: 4.3 – Premium Product Cards & Shopping Experience
{%- endcomment -%}

{%- assign show_delivery = show_delivery | default: true -%}

{%- if show_delivery -%}
  <div class="ncf-delivery-badges flex flex-wrap items-center gap-1.5 mt-1.5 text-[11px] text-slate-500 dark:text-slate-400">
    {%- if product.price >= 5000 or product.tags contains 'free-shipping' -%}
      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <span>Free Express Delivery</span>
      </span>
    {%- else -%}
      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Ships in 24 hrs</span>
      </span>
    {%- endif -%}

    {%- if product.tags contains 'warranty' or product.type contains 'Electronics' or product.type contains 'Audio' -%}
      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 font-medium border border-sky-100 dark:border-sky-900">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>2-Yr Warranty</span>
      </span>
    {%- endif -%}
  </div>
{%- endif -%}
