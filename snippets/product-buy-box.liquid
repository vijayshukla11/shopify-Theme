{%- comment -%}
  CLINZA Commerce - Snippet: Product Buy Box
  File: snippets/product-buy-box.liquid
  Architecture: High-Conversion Minimalist Electronics Buy Box adhering strictly to the
  CLINZA #173D32 color system, dynamic Shopify product data, and native OS 2.0 controls.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign show_dynamic_checkout = section.settings.enable_dynamic_checkout | default: true -%}
{%- assign show_trust = section.settings.enable_trust_badges | default: true -%}

{%- comment -%} Deterministic Category Eyebrow {%- endcomment -%}
{%- assign category_label = product.metafields.custom.category | default: product.type -%}
{%- if category_label == blank and product.collections.size > 0 -%}
  {%- assign category_label = product.collections.first.title -%}
{%- endif -%}

<div class="ncf-pdp-buybox flex flex-col gap-4 w-full text-[#111827]" data-product-buybox>

  {%- comment -%} 1. CATEGORY EYEBROW & SKU {%- endcomment -%}
  <div class="flex items-center justify-between text-xs font-mono">
    <div class="flex items-center gap-2">
      {%- if category_label != blank -%}
        <span class="font-bold uppercase tracking-wider text-[#173D32]">
          {{ category_label | escape }}
        </span>
        <span class="text-[#E5E7E5]">•</span>
      {%- endif -%}
      {%- if current_variant.sku != blank -%}
        <span class="text-[#667085]">SKU: <strong class="text-[#111827] font-semibold" data-pdp-sku>{{ current_variant.sku }}</strong></span>
      {%- endif -%}
    </div>

    {%- comment -%} Stock Status Indicator {%- endcomment -%}
    {% render 'product-card-stock', product: product, show_stock: true %}
  </div>

  {%- comment -%} 2. PRODUCT TITLE & RATING {%- endcomment -%}
  <div>
    <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-[#111827] leading-tight">
      {{ product.title | escape }}
    </h1>

    {%- comment -%} Rating Component (Gracefully hides when no genuine review data exists) {%- endcomment -%}
    <div class="mt-2 empty:hidden">
      {% render 'product-rating', product: product, show_rating: true %}
    </div>
  </div>

  {%- comment -%} 3. PRICING & SAVINGS {%- endcomment -%}
  <div class="py-3 px-4 rounded-xl bg-[#F7F8F6] border border-[#E5E7E5] flex items-center justify-between flex-wrap gap-2">
    <div class="flex items-baseline gap-2.5 flex-wrap">
      <span class="text-2xl font-extrabold text-[#111827] font-mono tracking-tight" data-product-price-current>
        {{ current_variant.price | money }}
      </span>

      {%- if current_variant.compare_at_price > current_variant.price -%}
        <span class="text-sm line-through text-[#667085] font-mono" data-product-price-compare>
          {{ current_variant.compare_at_price | money }}
        </span>

        {%- assign saved_amount = current_variant.compare_at_price | minus: current_variant.price -%}
        {%- assign saved_percent = saved_amount | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
        <span class="px-2 py-0.5 rounded-md bg-[#EAF1EE] text-[#173D32] text-xs font-bold font-mono">
          Save {{ saved_percent }}% ({{ saved_amount | money }})
        </span>
      {%- endif -%}
    </div>

    <span class="text-[11px] font-medium text-[#667085]">
      Inclusive of all taxes
    </span>
  </div>

  {%- comment -%} 4. SHORT DESCRIPTION / VALUE HIGHLIGHTS {%- endcomment -%}
  {%- assign short_desc = product.metafields.custom.short_description | default: product.metafields.descriptors.subtitle -%}
  {%- if short_desc == blank and product.description != blank -%}
    {%- assign short_desc = product.description | strip_html | truncatewords: 24 -%}
  {%- endif -%}

  {%- if short_desc != blank -%}
    <p class="text-xs sm:text-sm text-[#667085] leading-relaxed">
      {{ short_desc }}
    </p>
  {%- endif -%}

  {%- comment -%} 5. PRODUCT FORM & VARIANT OPTIONS {%- endcomment -%}
  <form method="post" action="{{ routes.cart_add_url }}" class="ncf-pdp-variant-form flex flex-col gap-4 mt-1" id="ncf-pdp-add-to-cart-form" data-pdp-form>
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-variant-id-input />
    <script type="application/json" data-product-json>{{ product | json }}</script>

    {%- unless product.has_only_default_variant -%}
      {%- for option in product.options_with_values -%}
        {%- assign option_name_downcase = option.name | downcase -%}
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs font-medium">
            <span class="text-[#111827]">
              {{ option.name }}: <strong class="text-[#173D32] font-semibold" data-selected-option-label="{{ forloop.index0 }}">{{ option.selected_value | default: option.values.first }}</strong>
            </span>
          </div>

          <div class="flex flex-wrap gap-2">
            {%- for value in option.values -%}
              {%- comment -%} Determine if this option value is available in any variant {%- endcomment -%}
              {%- assign is_available = true -%}
              <button
                type="button"
                class="ncf-pdp-pill-btn px-3.5 py-2 rounded-lg border text-xs font-medium transition-all focus:outline-none {% if value == option.selected_value or forloop.first and option.selected_value == blank %}border-[#173D32] bg-[#EAF1EE] text-[#173D32] font-semibold shadow-2xs{% else %}border-[#E5E7E5] bg-[#FFFFFF] text-[#111827] hover:border-[#173D32]/50{% endif %}"
                data-option-index="{{ option.position | minus: 1 }}"
                data-option-value="{{ value | escape }}"
              >
                {{ value }}
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endunless -%}

    {%- comment -%} 6. QUANTITY & ADD TO CART CTA {%- endcomment -%}
    <div class="flex items-center gap-3 pt-1">
      {%- comment -%} Accessible Quantity Control {%- endcomment -%}
      <div class="flex items-center rounded-lg border border-[#E5E7E5] bg-[#FFFFFF] p-0.5">
        <button
          type="button"
          class="w-9 h-9 rounded-md text-[#111827] hover:bg-[#F7F8F6] flex items-center justify-center font-bold text-base transition-colors focus:outline-none"
          data-qty-decrease
          aria-label="Decrease quantity"
        >
          −
        </button>
        <input
          type="number"
          name="quantity"
          value="1"
          min="1"
          max="10"
          class="w-10 text-center text-xs font-bold font-mono bg-transparent text-[#111827] focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
          data-qty-input
          aria-label="Product quantity"
        />
        <button
          type="button"
          class="w-9 h-9 rounded-md text-[#111827] hover:bg-[#F7F8F6] flex items-center justify-center font-bold text-base transition-colors focus:outline-none"
          data-qty-increase
          aria-label="Increase quantity"
        >
          +
        </button>
      </div>

      {%- comment -%} Primary CTA: ADD TO CART (#173D32) {%- endcomment -%}
      <button
        type="submit"
        class="flex-1 py-3 px-6 rounded-lg bg-[#173D32] hover:bg-[#0F2D25] text-white font-semibold text-xs uppercase tracking-wider shadow-xs transition-colors flex items-center justify-center gap-2 disabled:bg-[#E5E7E5] disabled:text-[#667085] disabled:cursor-not-allowed group/atc"
        data-pdp-submit-atc
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover/atc:scale-105" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span data-pdp-atc-text>
          {%- if current_variant.available -%}
            Add to Cart
          {%- else -%}
            Sold Out
          {%- endif -%}
        </span>
      </button>
    </div>

    {%- comment -%} 7. SECONDARY CTA: BUY NOW {%- endcomment -%}
    {%- if show_dynamic_checkout -%}
      <button
        type="button"
        class="w-full py-3 px-6 rounded-lg bg-[#FFFFFF] border-2 border-[#173D32] hover:bg-[#EAF1EE] text-[#173D32] font-semibold text-xs uppercase tracking-wider transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
        data-pdp-buy-now
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span>Buy Now</span>
      </button>
    {%- endif -%}
  </form>

  {%- comment -%} 8. TRUST & SERVICE INFORMATION ROW (Configurable & Dynamic) {%- endcomment -%}
  {%- if show_trust -%}
    {%- assign trust_cod = product.metafields.custom.cod_promise.value | default: section.settings.trust_badge_cod -%}
    {%- assign trust_warranty = product.metafields.custom.warranty.value | default: product.metafields.specs.warranty.value | default: section.settings.trust_badge_warranty -%}
    {%- assign trust_exchange = product.metafields.custom.replacement_policy.value | default: section.settings.trust_badge_exchange -%}
    {%- assign trust_shipping = product.metafields.custom.shipping_promise.value | default: section.settings.trust_badge_shipping -%}
    {%- assign trust_authenticity = product.metafields.custom.authenticity_promise.value | default: section.settings.trust_badge_authenticity -%}
    {%- assign trust_security = section.settings.trust_badge_security -%}

    {%- if trust_cod != blank or trust_warranty != blank or trust_exchange != blank or trust_shipping != blank or trust_authenticity != blank or trust_security != blank -%}
      <div class="pt-3 mt-1 border-t border-[#E5E7E5]">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 text-[11px] text-[#667085]">
          {%- if trust_cod != blank -%}
            <div class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#173D32" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-[#111827] font-medium">{{ trust_cod | escape }}</span>
            </div>
          {%- endif -%}
          {%- if trust_warranty != blank -%}
            <div class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#173D32" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-[#111827] font-medium">{{ trust_warranty | escape }}</span>
            </div>
          {%- endif -%}
          {%- if trust_exchange != blank -%}
            <div class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#173D32" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-[#111827] font-medium">{{ trust_exchange | escape }}</span>
            </div>
          {%- endif -%}
          {%- if trust_shipping != blank -%}
            <div class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#173D32" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-[#111827] font-medium">{{ trust_shipping | escape }}</span>
            </div>
          {%- endif -%}
          {%- if trust_authenticity != blank -%}
            <div class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#173D32" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-[#111827] font-medium">{{ trust_authenticity | escape }}</span>
            </div>
          {%- endif -%}
          {%- if trust_security != blank -%}
            <div class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#173D32" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="text-[#111827] font-medium">{{ trust_security | escape }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

</div>
