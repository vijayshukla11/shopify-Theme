{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Product Buy Box
  File: snippets/product-buy-box.liquid
  Sprint: 4.4 – Product Detail Page Foundation (Phase 1)
  Architecture: High-Conversion Product Buy Box reusing existing NCF components (Price, Rating,
  Badges, Stock, Delivery, Swatches), with Variant Selector, Quantity Controls, AJAX ATC,
  Dynamic Checkout, and Store Pickup Availability.
{%- endcomment -%}

{%- assign show_trust = section.settings.enable_trust_badges | default: true -%}
{%- assign show_dynamic_checkout = section.settings.enable_dynamic_checkout | default: true -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="ncf-pdp-buybox flex flex-col gap-5 w-full text-slate-900 dark:text-slate-100" data-product-buybox>
  
  {%- comment -%} 1. VENDOR & SKU & AVAILABILITY HEADER {%- endcomment -%}
  <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-mono">
    <div class="flex items-center gap-2">
      <span class="font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400">
        {{ product.vendor | default: 'Nova Audio' }}
      </span>
      <span>•</span>
      <span>SKU: <strong class="text-slate-700 dark:text-slate-300" data-pdp-sku>{{ current_variant.sku | default: 'NCF-PRO-001' }}</strong></span>
    </div>

    {%- comment -%} Stock Status Component Reuse {%- endcomment -%}
    {% render 'product-card-stock', product: product, show_stock: true %}
  </div>

  {%- comment -%} 2. PRODUCT TITLE & BADGES {%- endcomment -%}
  <div>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100 leading-tight">
      {{ product.title | default: 'Nova Pro Wireless Active Noise Cancelling Headphones' }}
    </h1>

    <div class="flex items-center gap-4 mt-2.5">
      {%- comment -%} Rating Component Reuse {%- endcomment -%}
      {% render 'product-rating', product: product, show_rating: true %}

      <span class="text-slate-300 dark:text-slate-700">•</span>
      <a href="#ncf-pdp-reviews" class="text-xs font-semibold text-sky-600 dark:text-sky-400 hover:underline">
        Read 128 Reviews
      </a>
    </div>
  </div>

  {%- comment -%} 3. PRICING & DISCOUNTS {%- endcomment -%}
  <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 flex items-center justify-between flex-wrap gap-3">
    {% render 'product-price', product: product, show_savings: true %}

    <span class="px-2.5 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 text-xs font-bold border border-emerald-200 dark:border-emerald-800">
      In Stock & Ready to Ship
    </span>
  </div>

  {%- comment -%} 4. VARIANT OPTIONS (SWATCHES & PILLS) {%- endcomment -%}
  <form method="post" action="{{ routes.cart_add_url }}" class="ncf-pdp-variant-form flex flex-col gap-5" id="ncf-pdp-add-to-cart-form" data-pdp-form>
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-variant-id-input />
    <script type="application/json" data-product-json>{{ product | json }}</script>

    {%- if product.options_with_values.size > 0 -%}
      {%- for option in product.options_with_values -%}
        {%- assign option_name_downcase = option.name | downcase -%}
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs font-bold">
            <span class="text-slate-700 dark:text-slate-300 uppercase tracking-wider font-mono">
              {{ option.name }}: <span class="text-sky-600 dark:text-sky-400 font-normal" data-selected-option-label="{{ forloop.index0 }}">{{ option.selected_value | default: option.values.first }}</span>
            </span>
            {%- if option_name_downcase contains 'size' or option_name_downcase contains 'fit' -%}
              <button type="button" class="text-sky-600 dark:text-sky-400 hover:underline text-[11px]">Size Guide</button>
            {%- endif -%}
          </div>

          <div class="flex flex-wrap gap-2">
            {%- for value in option.values -%}
              {%- if option_name_downcase contains 'color' or option_name_downcase contains 'colour' -%}
                <button
                  type="button"
                  class="ncf-pdp-swatch-btn relative px-3 py-2 rounded-xl border-2 text-xs font-bold flex items-center gap-2 transition-all focus:outline-none {% if value == option.selected_value or forloop.first %}border-sky-600 dark:border-sky-400 bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 shadow-xs{% else %}border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-slate-300{% endif %}"
                  data-option-index="{{ option.position | minus: 1 }}"
                  data-option-value="{{ value | escape }}"
                >
                  <span class="w-3.5 h-3.5 rounded-full border border-slate-300 dark:border-slate-700" style="background-color: {% if value contains 'Black' or value contains 'Midnight' %}#0f172a{% elsif value contains 'Silver' or value contains 'Grey' %}#94a3b8{% else %}#3b82f6{% endif %};"></span>
                  <span>{{ value }}</span>
                </button>
              {%- else -%}
                <button
                  type="button"
                  class="ncf-pdp-pill-btn px-4 py-2.5 rounded-xl border-2 text-xs font-bold transition-all focus:outline-none {% if value == option.selected_value or forloop.first %}border-sky-600 dark:border-sky-400 bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 shadow-xs{% else %}border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-slate-300{% endif %}"
                  data-option-index="{{ option.position | minus: 1 }}"
                  data-option-value="{{ value | escape }}"
                >
                  {{ value }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} DEMO VARIANT OPTIONS FOR PREVIEW MODE {%- endcomment -%}
      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-bold">
          <span class="text-slate-700 dark:text-slate-300 uppercase tracking-wider font-mono">
            Finish Color: <span class="text-sky-600 dark:text-sky-400 font-normal" data-selected-option-label="0">Space Black</span>
          </span>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="ncf-pdp-swatch-btn border-sky-600 dark:border-sky-400 bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 px-3.5 py-2 rounded-xl border-2 text-xs font-bold flex items-center gap-2">
            <span class="w-3.5 h-3.5 rounded-full bg-slate-900"></span>
            <span>Space Black</span>
          </button>
          <button type="button" class="ncf-pdp-swatch-btn border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 px-3.5 py-2 rounded-xl border-2 text-xs font-bold flex items-center gap-2 hover:border-slate-300">
            <span class="w-3.5 h-3.5 rounded-full bg-slate-300"></span>
            <span>Silver Metallic</span>
          </button>
          <button type="button" class="ncf-pdp-swatch-btn border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 px-3.5 py-2 rounded-xl border-2 text-xs font-bold flex items-center gap-2 hover:border-slate-300">
            <span class="w-3.5 h-3.5 rounded-full bg-sky-500"></span>
            <span>Nordic Blue</span>
          </button>
        </div>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-bold">
          <span class="text-slate-700 dark:text-slate-300 uppercase tracking-wider font-mono">
            Storage Capacity: <span class="text-sky-600 dark:text-sky-400 font-normal" data-selected-option-label="1">256GB High Speed</span>
          </span>
        </div>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="ncf-pdp-pill-btn border-sky-600 dark:border-sky-400 bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 px-4 py-2.5 rounded-xl border-2 text-xs font-bold">
            256GB High Speed
          </button>
          <button type="button" class="ncf-pdp-pill-btn border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 px-4 py-2.5 rounded-xl border-2 text-xs font-bold hover:border-slate-300">
            512GB Ultra Fast
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 5. QUANTITY SELECTOR & ADD TO CART CTA {%- endcomment -%}
    <div class="flex items-center gap-3 pt-2">
      <div class="flex items-center rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-1">
        <button
          type="button"
          class="w-10 h-10 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center font-bold text-lg focus:outline-none"
          data-qty-decrease
          aria-label="Decrease quantity"
        >
          -
        </button>
        <input
          type="number"
          name="quantity"
          value="1"
          min="1"
          max="10"
          class="w-12 text-center text-sm font-bold font-mono bg-transparent focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
          data-qty-input
          aria-label="Quantity"
        />
        <button
          type="button"
          class="w-10 h-10 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center justify-center font-bold text-lg focus:outline-none"
          data-qty-increase
          aria-label="Increase quantity"
        >
          +
        </button>
      </div>

      <button
        type="submit"
        class="flex-1 py-3.5 px-6 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-extrabold text-sm shadow-lg shadow-sky-600/20 hover:shadow-sky-600/40 transition-all flex items-center justify-center gap-2 group/atc"
        data-pdp-submit-atc
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover/atc:scale-110"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span data-pdp-atc-text>Add to Cart</span>
      </button>
    </div>

    {%- comment -%} 6. DYNAMIC CHECKOUT (BUY IT NOW) {%- endcomment -%}
    {%- if show_dynamic_checkout -%}
      <button
        type="button"
        class="w-full py-3.5 px-6 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-100 dark:hover:bg-white text-white dark:text-slate-900 font-extrabold text-sm shadow-md transition-all flex items-center justify-center gap-2"
        data-pdp-buy-now
      >
        <span>Buy with Shop Pay</span>
      </button>
    {%- endif -%}
  </form>

  {%- comment -%} 7. DELIVERY BADGES REUSE {%- endcomment -%}
  <div class="pt-2 border-t border-slate-200 dark:border-slate-800">
    {% render 'product-card-delivery', product: product, show_delivery: true %}
  </div>

  {%- comment -%} 8. STORE PICKUP AVAILABILITY {%- endcomment -%}
  <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 flex items-start gap-3">
    <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0 mt-0.5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
    </div>
    <div class="text-xs space-y-0.5">
      <p class="font-bold text-slate-800 dark:text-slate-200">Pickup available at Flagship Store</p>
      <p class="text-slate-500 dark:text-slate-400">Usually ready in 2 hours • <a href="#" class="text-sky-600 dark:text-sky-400 hover:underline">Check availability</a></p>
    </div>
  </div>

  {%- comment -%} 9. PAYMENT INSTALLMENT & TRUST INFO {%- endcomment -%}
  {% render 'product-payment-info' %}

  {%- comment -%} 10. TRUST BADGES {%- endcomment -%}
  {%- if show_trust -%}
    <div class="grid grid-cols-3 gap-2 pt-2 text-center text-[11px] text-slate-600 dark:text-slate-400 font-medium border-t border-slate-200 dark:border-slate-800">
      <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/40 flex flex-col items-center gap-1">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-sky-600"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Encrypted Checkout</span>
      </div>
      <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/40 flex flex-col items-center gap-1">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-sky-600"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        <span>30-Day Free Returns</span>
      </div>
      <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/40 flex flex-col items-center gap-1">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-sky-600"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span>Official Warranty</span>
      </div>
    </div>
  {%- endif -%}

</div>
