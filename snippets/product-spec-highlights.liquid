{%- comment -%}
  Nova Commerce Framework (NCF) - Snippet: Product Specification Highlights
  File: snippets/product-spec-highlights.liquid
  Sprint: 4.4 – Product Detail Page Foundation (Phase 1)
  Architecture: Grid-based Technical Specs & Feature Cards using Shopify Metafields with preview defaults.
{%- endcomment -%}

{%- assign processor = product.metafields.specs.processor.value | default: 'Dual-Core High-Speed Processor' -%}
{%- assign battery = product.metafields.specs.battery.value | default: '40 Hours Playback (ANC On)' -%}
{%- assign connectivity = product.metafields.specs.connectivity.value | default: 'Bluetooth 5.3 + Ultra Wideband' -%}
{%- assign display = product.metafields.specs.display.value | default: 'OLED Touch Status Control' -%}
{%- assign warranty = product.metafields.specs.warranty.value | default: '2-Year International Warranty' -%}
{%- assign drivers = product.metafields.specs.drivers.value | default: '40mm Custom Titanium Drivers' -%}

<div class="ncf-pdp-highlights w-full my-8 space-y-4" data-product-highlights>
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
    <h3 class="text-lg font-extrabold text-slate-900 dark:text-slate-100 flex items-center gap-2">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-sky-600"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      <span>Technical Specifications & Highlights</span>
    </h3>
    <span class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400 uppercase tracking-wider">
      Pro Grade Specs
    </span>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-3">
    {%- comment -%} 1. Processor / Chipset {%- endcomment -%}
    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1 hover:border-sky-500/40 transition-colors">
      <div class="text-sky-600 dark:text-sky-400">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="15" x2="23" y2="15"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="15" x2="4" y2="15"></line></svg>
      </div>
      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">Processor</span>
      <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100 block leading-snug">{{ processor }}</span>
    </div>

    {%- comment -%} 2. Battery & Fast Charge {%- endcomment -%}
    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1 hover:border-sky-500/40 transition-colors">
      <div class="text-sky-600 dark:text-sky-400">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="18" height="12" rx="2" ry="2"></rect><line x1="23" y1="11" x2="23" y2="13"></line><polygon points="11 8 7 12 10 12 9 16 13 12 10 12 11 8"></polygon></svg>
      </div>
      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">Battery Life</span>
      <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100 block leading-snug">{{ battery }}</span>
    </div>

    {%- comment -%} 3. Connectivity {%- endcomment -%}
    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1 hover:border-sky-500/40 transition-colors">
      <div class="text-sky-600 dark:text-sky-400">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
      </div>
      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">Connectivity</span>
      <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100 block leading-snug">{{ connectivity }}</span>
    </div>

    {%- comment -%} 4. Drivers & Audio {%- endcomment -%}
    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1 hover:border-sky-500/40 transition-colors">
      <div class="text-sky-600 dark:text-sky-400">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg>
      </div>
      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">Acoustics</span>
      <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100 block leading-snug">{{ drivers }}</span>
    </div>

    {%- comment -%} 5. Controls & Display {%- endcomment -%}
    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1 hover:border-sky-500/40 transition-colors">
      <div class="text-sky-600 dark:text-sky-400">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
      </div>
      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">Interface</span>
      <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100 block leading-snug">{{ display }}</span>
    </div>

    {%- comment -%} 6. Warranty {%- endcomment -%}
    <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1 hover:border-sky-500/40 transition-colors">
      <div class="text-sky-600 dark:text-sky-400">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      </div>
      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">Coverage</span>
      <span class="text-xs font-extrabold text-slate-900 dark:text-slate-100 block leading-snug">{{ warranty }}</span>
    </div>
  </div>
</div>
